app.маршрут("/включения", "GET", функция(з) {
    пусть контент = """
<h1>Включения</h1>
<p class="subtitle">Списковые и словарные comprehension.</p>

<h2>Списковые</h2>
<pre><code><span class="kw">пусть</span> числа = <span class="fn">диапазон</span>(<span class="num">1</span>, <span class="num">11</span>)

<span class="cmt">// Квадраты</span>
<span class="fn">лог</span>([x * x <span class="kw">для</span> x <span class="kw">в</span> числа])
<span class="cmt">// [1, 4, 9, 16, 25, 36, 49, 64, 81, 100]</span>

<span class="cmt">// Только чётные</span>
<span class="fn">лог</span>([x <span class="kw">для</span> x <span class="kw">в</span> числа <span class="kw">если</span> x % <span class="num">2</span> == <span class="num">0</span>])
<span class="cmt">// [2, 4, 6, 8, 10]</span>

<span class="cmt">// Из двух источников (вложенное)</span>
<span class="fn">лог</span>([[i, j] <span class="kw">для</span> i <span class="kw">в</span> диапазон(<span class="num">3</span>) <span class="kw">для</span> j <span class="kw">в</span> диапазон(<span class="num">3</span>)])
</code></pre>

<h2>Словарные</h2>
<pre><code><span class="kw">пусть</span> пары = [[<span class="num">1</span>, <span class="str">"а"</span>], [<span class="num">2</span>, <span class="str">"б"</span>], [<span class="num">3</span>, <span class="str">"в"</span>]]

<span class="fn">лог</span>({k: v <span class="kw">для</span> k, v <span class="kw">в</span> пары})
<span class="cmt">// {1: 'а', 2: 'б', 3: 'в'}</span>

<span class="kw">пусть</span> квадраты = {x: x * x <span class="kw">для</span> x <span class="kw">в</span> диапазон(<span class="num">1</span>, <span class="num">6</span>)}
<span class="cmt">// {1: 1, 2: 4, 3: 9, 4: 16, 5: 25}</span>
</code></pre>

<h2>С распаковкой</h2>
<pre><code><span class="kw">пусть</span> люди = [
    {<span class="str">"имя"</span>: <span class="str">"Алиса"</span>, <span class="str">"возраст"</span>: <span class="num">30</span>},
    {<span class="str">"имя"</span>: <span class="str">"Боб"</span>,   <span class="str">"возраст"</span>: <span class="num">25</span>}
]

<span class="kw">пусть</span> имена = [ч[<span class="str">"имя"</span>] <span class="kw">для</span> ч <span class="kw">в</span> люди]
<span class="kw">пусть</span> возраст_словарь = {ч[<span class="str">"имя"</span>]: ч[<span class="str">"возраст"</span>] <span class="kw">для</span> ч <span class="kw">в</span> люди}
</code></pre>
"""
    вернуть страница("Включения", "/включения", контент)
})

// ----------------------------------------------------------------
// Исключения
