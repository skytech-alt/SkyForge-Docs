// ================================================================
// Шаблон страницы
// ================================================================
функция страница(заголовок, путь, содержимое) {
    пусть меню = ""
    для группа в NAV {
        пусть items_html = ""
        для пункт в группа[1] {
            пусть cls = "nav-item"
            если пункт[0] == путь { cls = "nav-item active" }
            items_html = items_html + '<a class="' + cls + '" href="' + пункт[0] + '">' + пункт[1] + '</a>'
        }
        меню = меню + '<div class="nav-group">' + группа[0] + '</div>' + items_html
    }

    вернуть app.шаблон_из("""
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ заголовок }} — SkyForge</title>
  <meta name="description" content="SkyForge — русскоязычный язык программирования. ООП, async, веб, ORM, тесты.">
  <style>{{ CSS }}</style>
</head>
<body>
<div class="layout">
  <aside class="sidebar">
    <div class="logo">
      SkyForge <span style="font-size:10px;color:#8b93a7;font-weight:400">v{{ версия }}</span>
      <small>русскоязычный язык программирования</small>
    </div>
    <div class="search-wrap">
      <input id="search" type="text" placeholder="Поиск..." autocomplete="off">
    </div>
    {{ меню }}
  </aside>
  <main class="content">
    {{ содержимое }}
  </main>
  <aside class="toc" id="toc">
    <div class="toc-title">На этой странице</div>
  </aside>
</div>
<div class="footer">
  <div>SkyForge v{{ версия }} · MIT</div>
  <div>
    <a href="{{ пипи }}" target="_blank">PyPI</a> ·
    <a href="{{ репо }}" target="_blank">GitHub</a> ·
    <a href="/дорожная-карта">Дорожная карта</a>
  </div>
</div>
<script>{{ JS }}</script>
</body>
</html>
""", {
        "заголовок": заголовок,
        "CSS": CSS,
        "JS": JS,
        "меню": меню,
        "содержимое": содержимое,
        "версия": ВЕРСИЯ,
        "пипи": ПИПИ,
        "репо": РЕПО
    })
}

// ================================================================
// ГЛАВНАЯ
// ================================================================
app.маршрут("/", "GET", функция(з) {
    пусть контент = """
<div class="hero">
  <h1>SkyForge</h1>
  <p>Русскоязычный язык программирования. ООП, async, генераторы, pattern matching, веб-фреймворк, ORM и тесты — в одном языке, без импортов десятка библиотек.</p>
  <div class="cta">
    <a href="/быстрый-старт" class="primary">→ Быстрый старт</a>
    <a href="/установка" class="ghost">📦 Установка</a>
    <a href="{{ репо }}" class="ghost" target="_blank">★ GitHub</a>
  </div>
</div>

<h2>Что такое SkyForge</h2>
<p>Язык с русским синтаксисом и батарейками. Пишешь код как читаешь вслух — <code>пусть x = 5</code>, <code>функция сумма(a, b)</code>, <code>если x > 0</code>. Всё, что нужно для скрипта, API, блога или алгоритма — уже внутри.</p>

<div class="grid">
  <div class="card">
    <h3>🧠 Язык</h3>
    <p>Функции, классы с наследованием, лямбды, включения, декораторы, генераторы, async/await, pattern matching, опциональные типы, исключения.</p>
  </div>
  <div class="card">
    <h3>📚 Stdlib</h3>
    <p>Строки, коллекции, JSON, CSV, файлы, дата/время, regex, хэши, base64, URL, крипто, русские склонения.</p>
  </div>
  <div class="card">
    <h3>🌐 Веб</h3>
    <p>Маршруты, шаблоны <code>{% raw %}{{ }}&#123;% endraw %}</code>, JSON API, статика, middleware, сессии, автодокументация <code>/docs</code>.</p>
  </div>
  <div class="card">
    <h3>🗄 ORM</h3>
    <p>Модели, CRUD, запросы, сортировка, агрегация. SQLite из коробки, без единой строки SQL.</p>
  </div>
  <div class="card">
    <h3>🧪 Тесты</h3>
    <p>Декоратор <code>@тест("имя")</code>, ассерты, красивый отчёт, команда <code>SkyForge test</code>.</p>
  </div>
  <div class="card">
    <h3>🐍 Python-мост</h3>
    <p><code>подключить_питон("numpy")</code> — весь PyPI в одну строку. Десктоп, ML, Telegram-боты, парсинг.</p>
  </div>
</div>

<h2>Hello, world</h2>
<pre><code><span class="cmt">// hello.skf</span>
<span class="kw">функция</span> <span class="fn">привет</span>(имя) {
    <span class="kw">вернуть</span> <span class="str">"Привет, "</span> + имя + <span class="str">"!"</span>
}

<span class="fn">лог</span>(<span class="fn">привет</span>(<span class="str">"Мир"</span>))</code></pre>

<pre><code>$ SkyForge run hello.skf
<span class="str">Привет, Мир!</span></code></pre>

<h2>Почему SkyForge</h2>
<ul>
  <li><strong>Читается как инструкция</strong> — не нужно держать в голове английские ключевые слова.</li>
  <li><strong>Батарейки включены</strong> — web, ORM, tests, stdlib уже в языке.</li>
  <li><strong>Python под капотом</strong> — весь PyPI доступен через мост, .skf дружит с любыми библиотеками.</li>
  <li><strong>Готов к деплою</strong> — на Render, VPS, локально в одну команду.</li>
  <li><strong>Свой REPL</strong> — <code>SkyForge repl</code> для экспериментов.</li>
  <li><strong>Свой лаунчер</strong> — <code>SkyForge gui</code> с подсветкой синтаксиса.</li>
</ul>

<h2>Что нового</h2>
<div class="card">
  <h3>v{{ версия }}</h3>
  <ul style="margin-bottom:0">
    <li>Стабильный web-фреймворк с middleware и сессиями</li>
    <li>Async/await с реальным параллелизмом</li>
    <li>Pattern matching для списков и словарей</li>
    <li>Опциональная типизация в рантайме</li>
    <li>Декораторы: <code>@кешировать</code>, <code>@повторить(n)</code>, <code>@таймер_декоратор</code></li>
    <li>Python-мост возвращает корневой модуль — работает <code>os.path.join(...)</code></li>
  </ul>
</div>

<h2>REPL</h2>
<pre><code>$ SkyForge repl

<span class="fn">SkyForge</span> ❯ <span class="kw">пусть</span> x = <span class="num">10</span>
<span class="fn">SkyForge</span> ❯ x * <span class="num">2</span>
<span class="num">20</span>
<span class="fn">SkyForge</span> ❯ <span class="fn">диапазон</span>(<span class="num">1</span>, <span class="num">6</span>).<span class="fn">карта</span>(<span class="kw">функ</span>(n) { <span class="kw">вернуть</span> n * n })
[<span class="num">1</span>, <span class="num">4</span>, <span class="num">9</span>, <span class="num">16</span>, <span class="num">25</span>]</code></pre>

<h2>Куда дальше</h2>
<div class="grid">
  <a href="/быстрый-старт" class="card" style="display:block">
    <h3>⚡ Быстрый старт</h3>
    <p>От установки до первого API за 5 минут.</p>
  </a>
  <a href="/рецепты" class="card" style="display:block">
    <h3>🍳 Рецепты</h3>
    <p>Готовые сниппеты для типовых задач.</p>
  </a>
  <a href="/шпаргалка" class="card" style="display:block">
    <h3>📋 Шпаргалка</h3>
    <p>Весь синтаксис на одной странице.</p>
  </a>
  <a href="/faq" class="card" style="display:block">
    <h3>❓ FAQ</h3>
    <p>Частые вопросы и ответы.</p>
  </a>
</div>
"""
    вернуть страница("Введение", "/", контент)
})

// ================================================================
// УСТАНОВКА
// ================================================================
app.маршрут("/установка", "GET", функция(з) {
    пусть контент = """
<h1>Установка</h1>
<p class="subtitle">Одна команда — и язык у тебя.</p>

<h2>Требования</h2>
<ul>
  <li>Python 3.9 или новее (проверить: <code>python --version</code>)</li>
  <li>Windows, macOS или Linux</li>
</ul>

<h2>Через pip</h2>
<pre><code>pip install skyforge-lang</code></pre>

<h2>Проверка</h2>
<pre><code>SkyForge version
<span class="cmt"># SkyForge 1.0.4</span>
<span class="cmt"># Python: 3.12.0</span>
<span class="cmt"># Платформа: win32</span></code></pre>

<h2>Команды CLI</h2>
<pre><code>SkyForge repl                      <span class="cmt"># интерактивная консоль</span>
SkyForge run app.skf               <span class="cmt"># запустить файл</span>
SkyForge GAZUY app.skf             <span class="cmt"># запустить с баннером</span>
SkyForge check app.skf             <span class="cmt"># проверить синтаксис</span>
SkyForge test tests.skf            <span class="cmt"># прогнать тесты</span>
SkyForge web app.skf --port 8000   <span class="cmt"># веб-приложение</span>
SkyForge gui                       <span class="cmt"># графический лаунчер</span>
SkyForge version                   <span class="cmt"># версия и окружение</span></code></pre>

<h2>Из исходников</h2>
<pre><code>git clone {{ репо }}
cd SkyForge-Docs
pip install -e .</code></pre>

<h2>Обновление</h2>
<pre><code>pip install --upgrade skyforge-lang</code></pre>

<h2>Удаление</h2>
<pre><code>pip uninstall skyforge-lang</code></pre>

<h2>Частые проблемы</h2>
<div class="card">
  <h3>SkyForge не распознаётся</h3>
  <p>Venv не активирован или скрипт не в PATH. Используй модульный вызов: <code>python -m skyforge.cli version</code>.</p>
</div>
<div class="card">
  <h3>Кракозябры в консоли Windows</h3>
  <p>PowerShell → выполни: <code>chcp 65001</code> и <code>[Console]::OutputEncoding = [System.Text.Encoding]::UTF8</code>. Или добавь в профиль PowerShell.</p>
</div>
<div class="card">
  <h3>Не работают кириллические URL</h3>
  <p>В версии 1.0.4 исправлено — обнови: <code>pip install -U skyforge-lang</code>.</p>
</div>
"""
    вернуть страница("Установка", "/установка", контент)
})

// ================================================================
// БЫСТРЫЙ СТАРТ
// ================================================================
app.маршрут("/быстрый-старт", "GET", функция(з) {
    пусть контент = """
<h1>Быстрый старт</h1>
<p class="subtitle">От нуля до работающего API за 5 минут.</p>

<h2>1. Установка</h2>
<pre><code>pip install skyforge-lang</code></pre>

<h2>2. Первый скрипт</h2>
<p>Создай <code>hello.skf</code>:</p>
<pre><code><span class="fn">лог</span>(<span class="str">"Привет, мир!"</span>)

<span class="kw">пусть</span> имя = <span class="fn">ввод</span>(<span class="str">"Как тебя зовут? "</span>)
<span class="fn">лог</span>(<span class="str">"Привет, {имя}!"</span>)</code></pre>

<p>Запусти:</p>
<pre><code>SkyForge run hello.skf</code></pre>

<h2>3. Переменные и типы</h2>
<pre><code><span class="kw">пусть</span> имя = <span class="str">"Алиса"</span>       <span class="cmt">// строка</span>
<span class="kw">пусть</span> возраст = <span class="num">30</span>          <span class="cmt">// число</span>
<span class="kw">пусть</span> активна = истина      <span class="cmt">// булево</span>
<span class="kw">пусть</span> хобби = [<span class="str">"код"</span>, <span class="str">"кофе"</span>]  <span class="cmt">// список</span></code></pre>

<h2>4. Условия и циклы</h2>
<pre><code><span class="kw">если</span> возраст >= <span class="num">18</span> {
    <span class="fn">лог</span>(<span class="str">"Взрослый"</span>)
} <span class="kw">иначе</span> {
    <span class="fn">лог</span>(<span class="str">"Ребёнок"</span>)
}

<span class="kw">для</span> хобби_один <span class="kw">в</span> хобби {
    <span class="fn">лог</span>(<span class="str">"Увлекается: "</span> + хобби_один)
}</code></pre>

<h2>5. Функции</h2>
<pre><code><span class="kw">функция</span> <span class="fn">привет</span>(имя, приветствие = <span class="str">"Привет"</span>) {
    <span class="kw">вернуть</span> приветствие + <span class="str">", "</span> + имя
}

<span class="fn">лог</span>(<span class="fn">привет</span>(<span class="str">"Алиса"</span>))
<span class="fn">лог</span>(<span class="fn">привет</span>(<span class="str">"Боб"</span>, <span class="str">"Здравствуй"</span>))</code></pre>

<h2>6. Классы</h2>
<pre><code><span class="kw">класс</span> <span class="type">Точка</span> {
    <span class="kw">функция</span> <span class="fn">инициализация</span>(x, y) {
        <span class="kw">это</span>.x = x
        <span class="kw">это</span>.y = y
    }
    <span class="kw">функция</span> <span class="fn">длина</span>() {
        <span class="kw">вернуть</span> <span class="fn">корень</span>(<span class="kw">это</span>.x * <span class="kw">это</span>.x + <span class="kw">это</span>.y * <span class="kw">это</span>.y)
    }
}

<span class="kw">пусть</span> p = <span class="type">Точка</span>(<span class="num">3</span>, <span class="num">4</span>)
<span class="fn">лог</span>(p.<span class="fn">длина</span>())   <span class="cmt">// 5.0</span></code></pre>

<h2>7. Первый API</h2>
<pre><code><span class="kw">пусть</span> app = <span class="fn">приложение</span>()
<span class="kw">пусть</span> бд = <span class="fn">бд_открыть</span>(<span class="str">"todos.db"</span>)

<span class="kw">пусть</span> Задачи = <span class="fn">создать_модель</span>(
    имя = <span class="str">"Задача"</span>, таблица = <span class="str">"todos"</span>, бд = бд,
    поля = [
        {<span class="str">"имя"</span>: <span class="str">"id"</span>, <span class="str">"тип"</span>: <span class="str">"целое"</span>, <span class="str">"первичный"</span>: истина, <span class="str">"авто"</span>: истина},
        {<span class="str">"имя"</span>: <span class="str">"текст"</span>, <span class="str">"тип"</span>: <span class="str">"строка"</span>},
        {<span class="str">"имя"</span>: <span class="str">"готово"</span>, <span class="str">"тип"</span>: <span class="str">"булево"</span>, <span class="str">"по_умолчанию"</span>: ложь}
    ]
)
Задачи.<span class="fn">создать_таблицу</span>()

app.<span class="fn">маршрут</span>(<span class="str">"/todos"</span>, <span class="str">"GET"</span>, <span class="kw">функция</span>(з) { <span class="kw">вернуть</span> Задачи.<span class="fn">все</span>() })
app.<span class="fn">маршрут</span>(<span class="str">"/todos"</span>, <span class="str">"POST"</span>, <span class="kw">функция</span>(з) {
    <span class="kw">вернуть</span> Задачи.<span class="fn">создать</span>(текст = з[<span class="str">"json"</span>][<span class="str">"текст"</span>])
})

app.<span class="fn">запустить</span>(<span class="num">8000</span>)</code></pre>

<p>Запусти:</p>
<pre><code>SkyForge web todos.skf

<span class="cmt"># в другом терминале:</span>
curl http://localhost:8000/todos
curl -X POST http://localhost:8000/todos \
     -H "Content-Type: application/json" \
     -d '{"текст":"купить хлеб"}'</code></pre>

<h2>8. Тесты</h2>
<pre><code><span class="kw">@тест</span>(<span class="str">"сложение работает"</span>)
<span class="kw">функция</span> <span class="fn">т1</span>() {
    <span class="fn">ожидать_равно</span>(<span class="num">2</span> + <span class="num">2</span>, <span class="num">4</span>)
}

<span class="fn">запустить_тесты</span>()</code></pre>

<pre><code>SkyForge test tests.skf</code></pre>

<h2>Что дальше</h2>
<ul>
  <li><a href="/синтаксис">Синтаксис</a> — весь язык в деталях</li>
  <li><a href="/веб">Веб-фреймворк</a> — маршруты, шаблоны, сессии</li>
  <li><a href="/orm">ORM</a> — работа с базами данных</li>
  <li><a href="/рецепты">Рецепты</a> — готовые сниппеты</li>
</ul>
"""
    вернуть страница("Быстрый старт", "/быстрый-старт", контент)
})

// ================================================================
// СИНТАКСИС
// ================================================================
app.маршрут("/синтаксис", "GET", функция(з) {
    пусть контент = """
<h1>Синтаксис</h1>
<p class="subtitle">Всё, что нужно знать для старта.</p>

<h2>Комментарии</h2>
<pre><code><span class="cmt">// однострочный</span>
<span class="cmt"># тоже однострочный</span></code></pre>

<h2>Переменные</h2>
<pre><code><span class="kw">пусть</span> имя = <span class="str">"Алиса"</span>
<span class="kw">пусть</span> возраст = <span class="num">30</span>
возраст += <span class="num">1</span>       <span class="cmt">// 31</span>
возраст *= <span class="num">2</span>       <span class="cmt">// 62</span>
имя = <span class="str">"Боб"</span>          <span class="cmt">// переприсваивание</span></code></pre>

<h2>Вывод</h2>
<pre><code><span class="fn">лог</span>(<span class="str">"Привет"</span>)
<span class="fn">лог</span>(<span class="str">"Возраст: "</span> + возраст)
<span class="fn">лог</span>(<span class="str">"Через год: {возраст + 1}"</span>)   <span class="cmt">// интерполяция</span></code></pre>

<h2>Условия</h2>
<pre><code><span class="kw">если</span> оценка >= <span class="num">90</span> {
    <span class="fn">лог</span>(<span class="str">"Отлично"</span>)
} <span class="kw">иначе если</span> оценка >= <span class="num">75</span> {
    <span class="fn">лог</span>(<span class="str">"Хорошо"</span>)
} <span class="kw">иначе</span> {
    <span class="fn">лог</span>(<span class="str">"Надо поработать"</span>)
}</code></pre>

<h2>Тернарник</h2>
<pre><code><span class="kw">пусть</span> статус = возраст >= <span class="num">18</span> <span class="kw">если</span> <span class="str">"взрослый"</span> <span class="kw">иначе</span> <span class="str">"ребёнок"</span></code></pre>

<h2>Циклы</h2>
<pre><code><span class="cmt">// числовой — верхняя граница не включается</span>
<span class="kw">для</span> i <span class="kw">от</span> <span class="num">0</span> <span class="kw">до</span> <span class="num">10</span> {
    <span class="fn">лог</span>(i)
}

<span class="cmt">// с шагом</span>
<span class="kw">для</span> i <span class="kw">от</span> <span class="num">0</span> <span class="kw">до</span> <span class="num">100</span> <span class="kw">шаг</span> <span class="num">5</span> {
    <span class="fn">лог</span>(i)
}

<span class="cmt">// перебор</span>
<span class="kw">для</span> x <span class="kw">в</span> [<span class="num">1</span>, <span class="num">2</span>, <span class="num">3</span>] {
    <span class="fn">лог</span>(x)
}

<span class="cmt">// с распаковкой</span>
<span class="kw">для</span> k, v <span class="kw">в</span> словарь.<span class="fn">элементы</span>() {
    <span class="fn">лог</span>(k, <span class="str">"="</span>, v)
}

<span class="cmt">// пока</span>
<span class="kw">пусть</span> x = <span class="num">0</span>
<span class="kw">пока</span> x < <span class="num">10</span> {
    x += <span class="num">1</span>
}</code></pre>

<h2>Управление циклом</h2>
<pre><code><span class="kw">для</span> i <span class="kw">от</span> <span class="num">0</span> <span class="kw">до</span> <span class="num">10</span> {
    <span class="kw">если</span> i == <span class="num">3</span> { <span class="kw">продолжить</span> }
    <span class="kw">если</span> i > <span class="num">7</span> { <span class="kw">прервать</span> }
    <span class="fn">лог</span>(i)
}</code></pre>

<h2>Коллекции</h2>
<pre><code><span class="kw">пусть</span> lst = [<span class="num">1</span>, <span class="num">2</span>, <span class="num">3</span>]
<span class="kw">пусть</span> сл = {<span class="str">"имя"</span>: <span class="str">"Алиса"</span>, <span class="str">"возраст"</span>: <span class="num">30</span>}
<span class="kw">пусть</span> мн = <span class="fn">множество</span>([<span class="num">1</span>, <span class="num">2</span>, <span class="num">3</span>])

<span class="fn">лог</span>(lst[<span class="num">0</span>])           <span class="cmt">// 1</span>
<span class="fn">лог</span>(lst[<span class="num">1</span>:<span class="num">3</span>])         <span class="cmt">// [2, 3]</span>
<span class="fn">лог</span>(lst[::-<span class="num">1</span>])         <span class="cmt">// [3, 2, 1]</span>
<span class="fn">лог</span>(сл[<span class="str">"имя"</span>])          <span class="cmt">// Алиса</span>
сл[<span class="str">"город"</span>] = <span class="str">"Москва"</span></code></pre>

<h2>Операторы</h2>
<pre><code>+ - * / %           <span class="cmt">// арифметика</span>
== != > < >= <=     <span class="cmt">// сравнение</span>
и  или  не          <span class="cmt">// логика</span>
+= -= *= /= %=      <span class="cmt">// присваивание с операцией</span></code></pre>

<h2>Умное сложение</h2>
<p>Строка + число = строка. Как в JS, но безопаснее:</p>
<pre><code><span class="fn">лог</span>(<span class="str">"Возраст: "</span> + <span class="num">25</span>)       <span class="cmt">// Возраст: 25</span>
<span class="fn">лог</span>(<span class="num">25</span> + <span class="str">" лет"</span>)             <span class="cmt">// 25 лет</span>
<span class="fn">лог</span>(<span class="str">"Активен: "</span> + истина)      <span class="cmt">// Активен: истина</span></code></pre>
"""
    вернуть страница("Синтаксис", "/синтаксис", контент)
})

// ================================================================
// ФУНКЦИИ
// ================================================================
app.маршрут("/функции", "GET", функция(з) {
    пусть контент = """
<h1>Функции</h1>
<p class="subtitle">Именованные, анонимные, с типами и дефолтами.</p>

<h2>Обычная функция</h2>
<pre><code><span class="kw">функция</span> <span class="fn">сумма</span>(a, b) {
    <span class="kw">вернуть</span> a + b
}

<span class="fn">лог</span>(<span class="fn">сумма</span>(<span class="num">2</span>, <span class="num">3</span>))   <span class="cmt">// 5</span></code></pre>

<h2>Дефолтные аргументы</h2>
<pre><code><span class="kw">функция</span> <span class="fn">привет</span>(имя, приветствие = <span class="str">"Привет"</span>) {
    <span class="kw">вернуть</span> приветствие + <span class="str">", "</span> + имя
}

<span class="fn">лог</span>(<span class="fn">привет</span>(<span class="str">"Алиса"</span>))
<span class="fn">лог</span>(<span class="fn">привет</span>(<span class="str">"Боб"</span>, <span class="str">"Здравствуй"</span>))</code></pre>

<h2>Именованные аргументы</h2>
<pre><code><span class="fn">привет</span>(имя = <span class="str">"Катя"</span>, приветствие = <span class="str">"Хай"</span>)
<span class="fn">привет</span>(приветствие = <span class="str">"Йо"</span>, имя = <span class="str">"Дима"</span>)   <span class="cmt">// порядок не важен</span></code></pre>

<h2>Лямбды</h2>
<pre><code><span class="kw">пусть</span> удвоить = <span class="kw">функция</span>(x) { <span class="kw">вернуть</span> x * <span class="num">2</span> }
<span class="kw">пусть</span> утроить = <span class="kw">функ</span>(x) { <span class="kw">вернуть</span> x * <span class="num">3</span> }   <span class="cmt">// короткая форма</span>

<span class="fn">лог</span>(<span class="fn">удвоить</span>(<span class="num">21</span>))   <span class="cmt">// 42</span></code></pre>

<h2>Функции высшего порядка</h2>
<pre><code><span class="kw">пусть</span> числа = [<span class="num">1</span>, <span class="num">2</span>, <span class="num">3</span>, <span class="num">4</span>, <span class="num">5</span>]

<span class="fn">лог</span>(числа.<span class="fn">карта</span>(<span class="kw">функ</span>(x) { <span class="kw">вернуть</span> x * x }))          <span class="cmt">// [1, 4, 9, 16, 25]</span>
<span class="fn">лог</span>(числа.<span class="fn">фильтр</span>(<span class="kw">функ</span>(x) { <span class="kw">вернуть</span> x % <span class="num">2</span> == <span class="num">0</span> }))    <span class="cmt">// [2, 4]</span>
<span class="fn">лог</span>(числа.<span class="fn">уменьшить</span>(<span class="kw">функ</span>(a, b) { <span class="kw">вернуть</span> a + b }, <span class="num">0</span>))    <span class="cmt">// 15</span></code></pre>

<h2>Типы параметров и возврата</h2>
<pre><code><span class="kw">функция</span> <span class="fn">сумма</span>(a: <span class="type">число</span>, b: <span class="type">число</span>) -> <span class="type">число</span> {
    <span class="kw">вернуть</span> a + b
}

<span class="fn">сумма</span>(<span class="num">2</span>, <span class="num">3</span>)                <span class="cmt">// OK → 5</span>
<span class="fn">сумма</span>(<span class="str">"2"</span>, <span class="str">"3"</span>)            <span class="cmt">// TypeError: ожидалось 'число'</span></code></pre>

<h2>Рекурсия</h2>
<pre><code><span class="kw">функция</span> <span class="fn">фибо</span>(n) {
    <span class="kw">если</span> n <= <span class="num">1</span> { <span class="kw">вернуть</span> n }
    <span class="kw">вернуть</span> <span class="fn">фибо</span>(n - <span class="num">1</span>) + <span class="fn">фибо</span>(n - <span class="num">2</span>)
}

<span class="fn">лог</span>(<span class="fn">фибо</span>(<span class="num">10</span>))   <span class="cmt">// 55</span></code></pre>
"""
    вернуть страница("Функции", "/функции", контент)
})

// ================================================================
// КЛАССЫ
// ================================================================
app.маршрут("/классы", "GET", функция(з) {
    пусть контент = """
<h1>Классы</h1>
<p class="subtitle">ООП с наследованием и <code>супер</code>.</p>

<h2>Простой класс</h2>
<pre><code><span class="kw">класс</span> <span class="type">Точка</span> {
    <span class="kw">функция</span> <span class="fn">инициализация</span>(x, y) {
        <span class="kw">это</span>.x = x
        <span class="kw">это</span>.y = y
    }
    <span class="kw">функция</span> <span class="fn">длина</span>() {
        <span class="kw">вернуть</span> <span class="fn">корень</span>(<span class="kw">это</span>.x * <span class="kw">это</span>.x + <span class="kw">это</span>.y * <span class="kw">это</span>.y)
    }
}

<span class="kw">пусть</span> p = <span class="type">Точка</span>(<span class="num">3</span>, <span class="num">4</span>)
<span class="fn">лог</span>(p.<span class="fn">длина</span>())   <span class="cmt">// 5.0</span></code></pre>

<h2>Наследование</h2>
<pre><code><span class="kw">класс</span> <span class="type">Животное</span> {
    <span class="kw">функция</span> <span class="fn">инициализация</span>(имя) { <span class="kw">это</span>.имя = имя }
    <span class="kw">функция</span> <span class="fn">говорить</span>() { <span class="kw">вернуть</span> <span class="str">"..."</span> }
    <span class="kw">функция</span> <span class="fn">представиться</span>() {
        <span class="kw">вернуть</span> <span class="str">"Я "</span> + <span class="kw">это</span>.имя + <span class="str">", говорю: "</span> + <span class="kw">это</span>.<span class="fn">говорить</span>()
    }
}

<span class="kw">класс</span> <span class="type">Собака</span> <span class="kw">наследник</span> <span class="type">Животное</span> {
    <span class="kw">функция</span> <span class="fn">говорить</span>() { <span class="kw">вернуть</span> <span class="str">"Гав!"</span> }
    <span class="kw">функция</span> <span class="fn">сидеть</span>() { <span class="kw">вернуть</span> <span class="kw">это</span>.имя + <span class="str">" сидит"</span> }
}

<span class="kw">пусть</span> с = <span class="type">Собака</span>(<span class="str">"Шарик"</span>)
<span class="fn">лог</span>(с.<span class="fn">представиться</span>())   <span class="cmt">// Я Шарик, говорю: Гав!</span>
<span class="fn">лог</span>(с.<span class="fn">сидеть</span>())           <span class="cmt">// Шарик сидит</span></code></pre>

<h2>Вызов родителя</h2>
<pre><code><span class="kw">класс</span> <span class="type">Кот</span> <span class="kw">наследник</span> <span class="type">Животное</span> {
    <span class="kw">функция</span> <span class="fn">говорить</span>() {
        <span class="kw">вернуть</span> <span class="fn">супер</span>.<span class="fn">говорить</span>() + <span class="str">" Мяу!"</span>
    }
}

<span class="fn">лог</span>(<span class="type">Кот</span>(<span class="str">"Барсик"</span>).<span class="fn">говорить</span>())   <span class="cmt">// ... Мяу!</span></code></pre>

<h2>Атрибуты класса + цепочки</h2>
<pre><code><span class="kw">класс</span> <span class="type">Счётчик</span> {
    значение = <span class="num">0</span>

    <span class="kw">функция</span> <span class="fn">прибавить</span>(n) {
        <span class="kw">это</span>.значение += n
        <span class="kw">вернуть</span> <span class="kw">это</span>            <span class="cmt">// для цепочки</span>
    }
}

<span class="kw">пусть</span> c = <span class="type">Счётчик</span>()
c.<span class="fn">прибавить</span>(<span class="num">5</span>).<span class="fn">прибавить</span>(<span class="num">10</span>).<span class="fn">прибавить</span>(<span class="num">100</span>)
<span class="fn">лог</span>(c.значение)   <span class="cmt">// 115</span></code></pre>
"""
    вернуть страница("Классы", "/классы", контент)
})

// ================================================================
// ВКЛЮЧЕНИЯ
