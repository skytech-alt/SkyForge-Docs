// ================================================================
// SkyForge Documentation v2 — сайт документации на самом SkyForge
// ================================================================

пусть app = приложение()
app.имя("SkyForge — документация")
app.отладка(истина)

пусть ВЕРСИЯ = "1.0.4"
пусть РЕПО = "https://github.com/skytech-alt/SkyForge-Docs"
пусть ПИПИ = "https://pypi.org/project/skyforge-lang/"

// ================================================================
// CSS
// ================================================================
пусть CSS = """
:root {
    --bg: #0a0c10; --panel: #0f1117; --panel-2: #161923;
    --border: #242938; --text: #e6e9f2; --muted: #8b93a7;
    --accent: #8b6cff; --accent-2: #a592ff; --success: #3ddc84;
    --code-bg: #0b0d13; --kw: #c586c0; --str: #ce9178;
    --num: #b5cea8; --cmt: #6a9955; --fn: #dcdcaa; --type: #4ec9b0;
    --r: 10px;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
    font-family: -apple-system, 'Segoe UI', system-ui, sans-serif;
    background: var(--bg); color: var(--text);
    line-height: 1.65; font-size: 15px;
    -webkit-font-smoothing: antialiased;
}
a { color: var(--accent-2); text-decoration: none; transition: color .15s; }
a:hover { color: var(--accent); }
::selection { background: var(--accent); color: #fff; }

/* layout */
.layout {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr) 220px;
    max-width: 1400px; margin: 0 auto; min-height: 100vh;
}

/* sidebar */
.sidebar {
    background: var(--panel); border-right: 1px solid var(--border);
    padding: 20px 0; position: sticky; top: 0; height: 100vh;
    overflow-y: auto;
}
.sidebar::-webkit-scrollbar { width: 6px; }
.sidebar::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
.logo {
    padding: 0 22px 18px; font-size: 22px; font-weight: 800;
    color: var(--accent-2); letter-spacing: -0.5px;
}
.logo small {
    display: block; font-size: 11px; color: var(--muted);
    font-weight: 400; margin-top: 3px; letter-spacing: 0;
}
.search-wrap { padding: 0 16px 14px; }
.search-wrap input {
    width: 100%; background: var(--panel-2); border: 1px solid var(--border);
    color: var(--text); padding: 8px 12px; border-radius: 6px;
    font-size: 13px; outline: none; transition: border-color .15s;
    font-family: inherit;
}
.search-wrap input:focus { border-color: var(--accent); }
.search-wrap input::placeholder { color: var(--muted); }

.nav-group {
    padding: 14px 22px 6px; font-size: 10px; text-transform: uppercase;
    color: var(--muted); letter-spacing: 1.2px; font-weight: 700;
}
.nav-item {
    display: block; padding: 7px 22px; color: #c8cce0;
    font-size: 13.5px; border-left: 2px solid transparent;
    transition: background .1s, color .1s;
}
.nav-item:hover { background: var(--panel-2); color: var(--text); }
.nav-item.active {
    color: var(--accent-2); background: var(--panel-2);
    border-left-color: var(--accent);
}

/* content */
.content { padding: 42px 48px 80px; min-width: 0; }
.content h1 {
    font-size: 32px; margin-bottom: 6px; color: #fff;
    letter-spacing: -0.6px; line-height: 1.2;
}
.content h1 + p.subtitle {
    color: var(--muted); margin-bottom: 30px; font-size: 15px;
}
.content h2 {
    font-size: 22px; margin: 44px 0 14px; color: #fff;
    letter-spacing: -0.3px; padding-top: 8px;
    scroll-margin-top: 20px;
}
.content h3 { font-size: 16.5px; margin: 24px 0 10px; color: var(--type); }
.content p { margin-bottom: 12px; color: #d0d4e0; }
.content ul, .content ol { margin: 12px 0 14px 22px; }
.content li { margin-bottom: 5px; color: #d0d4e0; }
.content strong { color: #fff; font-weight: 600; }

/* code */
pre {
    position: relative; background: var(--code-bg);
    border: 1px solid var(--border); border-radius: var(--r);
    padding: 18px 20px; overflow-x: auto; margin: 14px 0;
    font-family: 'JetBrains Mono', 'Consolas', 'Menlo', monospace;
    font-size: 13px; line-height: 1.6;
}
pre code { background: none; padding: 0; color: var(--code-fg); font-size: inherit; }
code {
    background: var(--panel-2); padding: 2px 7px; border-radius: 4px;
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 13px; color: var(--kw);
}
.kw { color: var(--kw); } .str { color: var(--str); } .num { color: var(--num); }
.cmt { color: var(--cmt); } .fn { color: var(--fn); } .type { color: var(--type); }

.copy-btn {
    position: absolute; top: 8px; right: 10px;
    background: var(--panel-2); color: var(--muted);
    border: 1px solid var(--border); border-radius: 5px;
    font-size: 11px; padding: 4px 9px; cursor: pointer;
    font-family: inherit; transition: all .15s; opacity: 0;
}
pre:hover .copy-btn { opacity: 1; }
.copy-btn:hover { color: var(--accent-2); border-color: var(--accent); }
.copy-btn.done { color: var(--success); border-color: var(--success); }

/* cards */
.card {
    background: var(--panel); border: 1px solid var(--border);
    border-radius: var(--r); padding: 18px 22px; margin: 14px 0;
    transition: border-color .15s, transform .15s;
}
.card:hover { border-color: #353c56; }
.card h3 { margin-top: 0; color: var(--type); font-size: 15px; }

.grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px; margin: 20px 0;
}
.grid .card:hover { border-color: var(--accent); transform: translateY(-2px); }

.tag {
    display: inline-block; background: var(--panel-2); color: var(--accent-2);
    padding: 2px 9px; border-radius: 12px; font-size: 11.5px;
    margin-right: 5px; font-weight: 600; border: 1px solid var(--border);
}
.badge {
    display: inline-block; background: linear-gradient(135deg, var(--accent), #b294ff);
    color: #fff; padding: 3px 10px; border-radius: 6px;
    font-size: 11px; font-weight: 700; vertical-align: middle;
    letter-spacing: 0.3px;
}

/* hero */
.hero {
    padding: 60px 0 50px;
    background: radial-gradient(ellipse at top left, rgba(139,108,255,.15), transparent 60%);
    margin: -42px -48px 0; padding-left: 48px; padding-right: 48px;
    border-bottom: 1px solid var(--border);
}
.hero h1 {
    font-size: 46px; line-height: 1.1; margin-bottom: 14px;
    background: linear-gradient(135deg, #fff 0%, var(--accent-2) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text; letter-spacing: -1.5px;
}
.hero p {
    font-size: 17px; color: var(--muted); max-width: 640px;
    margin-bottom: 28px;
}
.hero .cta { display: flex; gap: 10px; flex-wrap: wrap; }
.hero .cta a {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 10px 18px; border-radius: 8px; font-size: 14px;
    font-weight: 600; transition: all .15s;
}
.hero .cta a.primary {
    background: var(--accent); color: #fff;
}
.hero .cta a.primary:hover {
    background: var(--accent-2); transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(139,108,255,.35);
}
.hero .cta a.ghost {
    background: var(--panel-2); color: var(--text);
    border: 1px solid var(--border);
}
.hero .cta a.ghost:hover { border-color: var(--accent); color: var(--accent-2); }

/* toc */
.toc {
    position: sticky; top: 20px; padding: 42px 20px 20px 4px;
    font-size: 13px; max-height: 100vh; overflow-y: auto;
}
.toc-title {
    font-size: 10px; text-transform: uppercase; color: var(--muted);
    letter-spacing: 1.2px; font-weight: 700; margin-bottom: 10px;
}
.toc-item {
    display: block; color: var(--muted); padding: 4px 0;
    border-left: 2px solid transparent; padding-left: 10px;
    margin-left: -12px; transition: all .15s; line-height: 1.4;
}
.toc-item:hover { color: var(--accent-2); border-left-color: var(--accent); }

/* footer */
.footer {
    grid-column: 1 / -1;
    padding: 24px 48px; border-top: 1px solid var(--border);
    color: var(--muted); font-size: 13px;
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px;
}
.footer a { color: var(--muted); }
.footer a:hover { color: var(--accent-2); }

hr { border: none; border-top: 1px solid var(--border); margin: 36px 0; }

/* mobile */
@media (max-width: 1100px) {
    .layout { grid-template-columns: 240px minmax(0,1fr); }
    .toc { display: none; }
}
@media (max-width: 780px) {
    .layout { grid-template-columns: 1fr; }
    .sidebar { position: static; height: auto; max-height: 320px; }
    .content { padding: 28px 20px 60px; }
    .hero { margin: -28px -20px 0; padding: 40px 20px; }
    .hero h1 { font-size: 32px; }
    .footer { padding: 20px; }
}
"""

// ================================================================
// JS — кнопка копирования + TOC + поиск
// ================================================================
пусть JS = """
(function(){
    // Кнопка «Копировать» на каждом pre
    document.querySelectorAll('pre').forEach(function(pre){
        if (pre.querySelector('.copy-btn')) return;
        var btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.textContent = 'Копировать';
        btn.addEventListener('click', function(){
            var code = pre.querySelector('code') || pre;
            var text = code.innerText;
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text);
            } else {
                var ta = document.createElement('textarea');
                ta.value = text; document.body.appendChild(ta);
                ta.select(); document.execCommand('copy');
                document.body.removeChild(ta);
            }
            btn.textContent = 'Скопировано';
            btn.classList.add('done');
            setTimeout(function(){
                btn.textContent = 'Копировать';
                btn.classList.remove('done');
            }, 1500);
        });
        pre.appendChild(btn);
    });

    // Оглавление справа
    var toc = document.getElementById('toc');
    var content = document.querySelector('.content');
    if (toc && content) {
        var headings = content.querySelectorAll('h2');
        if (headings.length === 0) {
            toc.style.display = 'none';
        } else {
            headings.forEach(function(h, i){
                if (!h.id) {
                    h.id = 'h-' + i + '-' + h.textContent
                        .toLowerCase()
                        .replace(/[^a-zа-я0-9]+/gi, '-')
                        .replace(/^-|-$/g, '');
                }
                var a = document.createElement('a');
                a.href = '#' + h.id;
                a.className = 'toc-item';
                a.textContent = h.textContent;
                toc.appendChild(a);
            });
        }
    }

    // Поиск в сайдбаре
    var s = document.getElementById('search');
    if (s) {
        s.addEventListener('input', function(){
            var q = this.value.toLowerCase().trim();
            var groups = document.querySelectorAll('.nav-group');
            document.querySelectorAll('.nav-item').forEach(function(a){
                var ok = a.textContent.toLowerCase().indexOf(q) !== -1;
                a.style.display = ok ? 'block' : 'none';
            });
            groups.forEach(function(g){
                var next = g.nextElementSibling;
                var any = false;
                while (next && next.classList.contains('nav-item')) {
                    if (next.style.display !== 'none') { any = true; break; }
                    next = next.nextElementSibling;
                }
                g.style.display = any || !q ? 'block' : 'none';
            });
        });
    }
})();
"""

