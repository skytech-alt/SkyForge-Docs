// ================================================================
// Шаблон страницы
// ================================================================
функция страница(заголовок, путь, содержимое) {
    содержимое = содержимое.заменить("{{ репо }}", РЕПО)
    содержимое = содержимое.заменить("{{ пипи }}", ПИПИ)
    содержимое = содержимое.заменить("{{ версия }}", ВЕРСИЯ)

    пусть меню = ""
    для группа в NAV {
        пусть items_html = ""
        для пункт в группа[1] {
            пусть cls = "nav-item"
            если пункт[0] == путь { cls = "nav-item active" }
            items_html = items_html + '<a class="' + cls + '" href="' + пункт[0] + '">' + пункт[1] + '</a>'
        }
        меню = меню + '<div class="nav-group">' + группа[0] + '</div>' + items_html
    }

    вернуть app.шаблон_из("""
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ заголовок }} — SkyForge</title>
  <meta name="description" content="SkyForge — русскоязычный язык программирования. ООП, async, веб, ORM, тесты.">
  <style>{{ CSS | безопасно }}</style>
</head>
<body>
<div class="layout">
  <aside class="sidebar">
    <div class="logo">
      SkyForge <span style="font-size:10px;color:#8b93a7;font-weight:400">v{{ версия }}</span>
      <small>русскоязычный язык программирования</small>
    </div>
    <div class="search-wrap">
      <input id="search" type="text" placeholder="Поиск..." autocomplete="off">
    </div>
    {{ меню | безопасно }}
  </aside>
  <main class="content">
    {{ содержимое | безопасно }}
  </main>
  <aside class="toc" id="toc">
    <div class="toc-title">На этой странице</div>
  </aside>
</div>
<div class="footer">
  <div>
    SkyForge v{{ версия }} · MIT ·
    <span style="color:#3ddc84">✅ 79/79 тестов</span>
  </div>
  <div>
    Сделано на <strong style="color:#9b83ff">SkyForge</strong> ·
    <a href="{{ пипи }}" target="_blank">PyPI</a> ·
    <a href="{{ репо }}" target="_blank">GitHub</a> ·
    <a href="/дорожная-карта">Дорожная карта</a>
  </div>
</div>
<script>{{ JS | безопасно }}</script>
{{ метрика | безопасно }}
</body>
</html>
""", {
        "заголовок": заголовок,
        "CSS": CSS,
        "JS": JS,
        "меню": меню,
        "содержимое": содержимое,
        "версия": ВЕРСИЯ,
        "пипи": ПИПИ,
        "репо": РЕПО,
        "метрика": МЕТРИКА
    })
}

