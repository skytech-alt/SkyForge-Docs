app.маршрут("/исключения", "GET", функция(з) {
    пусть контент = """
<h1>Исключения</h1>
<p class="subtitle">try / catch / finally / throw.</p>

<h2>Базовый синтаксис</h2>
<pre><code><span class="kw">попробовать</span> {
    <span class="kw">пусть</span> r = <span class="num">1</span> / <span class="num">0</span>
} <span class="kw">поймать</span> e {
    <span class="fn">лог</span>(<span class="str">"Ошибка: "</span> + e)
} <span class="kw">наконец</span> {
    <span class="fn">лог</span>(<span class="str">"Всегда выполняется"</span>)
}</code></pre>

<h2>Свои ошибки</h2>
<pre><code><span class="kw">функция</span> <span class="fn">проверить_возраст</span>(возраст) {
    <span class="kw">если</span> возраст < <span class="num">0</span> {
        <span class="kw">бросить</span> <span class="str">"Возраст не может быть отрицательным"</span>
    }
    вернуть возраст
}

<span class="kw">попробовать</span> {
    <span class="fn">проверить_возраст</span>(-<span class="num">5</span>)
} <span class="kw">поймать</span> e {
    <span class="fn">лог</span>(e)
}</code></pre>

<h2>Вложенные</h2>
<pre><code><span class="kw">попробовать</span> {
    <span class="kw">попробовать</span> {
        <span class="kw">бросить</span> <span class="str">"внутренняя"</span>
    } <span class="kw">поймать</span> e {
        <span class="fn">лог</span>(<span class="str">"Поймал внутри: "</span> + e)
        <span class="kw">бросить</span> <span class="str">"перебросил наружу"</span>
    }
} <span class="kw">поймать</span> e {
    <span class="fn">лог</span>(<span class="str">"Снаружи: "</span> + e)
}</code></pre>

<h2>Assert</h2>
<pre><code><span class="kw">проверить</span> <span class="num">2</span> + <span class="num">2</span> == <span class="num">4</span>, <span class="str">"Математика сломалась"</span>
<span class="kw">проверить</span> <span class="str">"abc"</span>.<span class="fn">длина</span>() == <span class="num">3</span></code></pre>
"""
    вернуть страница("Исключения", "/исключения", контент)
})

// ================================================================
// ТИПЫ
// ================================================================
app.маршрут("/типы", "GET", функция(з) {
    пусть контент = """
<h1>Типы</h1>
<p class="subtitle">Опциональная типизация с проверкой в рантайме.</p>

<h2>Доступные типы</h2>
<div class="card">
<p><span class="tag">число</span> int или float</p>
<p><span class="tag">целое</span> int</p>
<p><span class="tag">дробное</span> float</p>
<p><span class="tag">строка</span> str</p>
<p><span class="tag">булево</span> bool</p>
<p><span class="tag">список</span> list</p>
<p><span class="tag">словарь</span> dict</p>
<p><span class="tag">множество</span> set</p>
<p><span class="tag">кортеж</span> tuple</p>
<p><span class="tag">ничего</span> None</p>
<p><span class="tag">любой</span> без проверки</p>
</div>

<h2>Синтаксис</h2>
<pre><code><span class="kw">функция</span> <span class="fn">сумма</span>(a: <span class="type">число</span>, b: <span class="type">число</span>) -> <span class="type">число</span> {
    <span class="kw">вернуть</span> a + b
}

<span class="kw">функция</span> <span class="fn">привет</span>(
    имя: <span class="type">строка</span>,
    приветствие: <span class="type">строка</span> = <span class="str">"Привет"</span>
) -> <span class="type">строка</span> {
    <span class="kw">вернуть</span> приветствие + <span class="str">", "</span> + имя
}</code></pre>

<h2>Проверка</h2>
<pre><code><span class="fn">сумма</span>(<span class="num">2</span>, <span class="num">3</span>)           <span class="cmt">// OK</span>
<span class="fn">сумма</span>(<span class="str">"2"</span>, <span class="str">"3"</span>)       <span class="cmt">// TypeError: параметр 'a' в сумма:</span>
                     <span class="cmt">//   ожидалось 'число', получено 'str'</span></code></pre>

<h2>Проверка типа значения</h2>
<pre><code><span class="fn">тип</span>(<span class="num">42</span>)           <span class="cmt">// "int"</span>
<span class="fn">тип</span>(<span class="str">"привет"</span>)     <span class="cmt">// "str"</span>
<span class="fn">тип</span>([<span class="num">1</span>, <span class="num">2</span>])       <span class="cmt">// "list"</span>
<span class="fn">тип</span>(истина)        <span class="cmt">// "bool"</span>
<span class="fn">тип</span>(ничего)        <span class="cmt">// "NoneType"</span></code></pre>

<h2>Когда использовать</h2>
<ul>
  <li>Публичные функции библиотек — явные типы улучшают документацию.</li>
  <li>Стыки с внешними данными (JSON, API) — сразу поймает неверный формат.</li>
  <li>Большие проекты — помогает рефакторингу.</li>
  <li>Не обязательно везде — можно оставить пустой.</li>
</ul>
"""
    вернуть страница("Типы", "/типы", контент)
})

// ================================================================
// ГЕНЕРАТОРЫ
// ================================================================
app.маршрут("/генераторы", "GET", функция(з) {
    пусть контент = """
<h1>Генераторы</h1>
<p class="subtitle">Ленивые последовательности через <code>выдать</code>.</p>

<h2>Простой генератор</h2>
<pre><code><span class="kw">функция</span> <span class="fn">числа_до</span>(n) {
    <span class="kw">для</span> i <span class="kw">от</span> <span class="num">1</span> <span class="kw">до</span> n + <span class="num">1</span> {
        <span class="kw">выдать</span> i
    }
}

<span class="kw">для</span> x <span class="kw">в</span> <span class="fn">числа_до</span>(<span class="num">5</span>) {
    <span class="fn">лог</span>(x)   <span class="cmt">// 1, 2, 3, 4, 5</span>
}</code></pre>

<h2>Бесконечный</h2>
<pre><code><span class="kw">функция</span> <span class="fn">фибо</span>() {
    <span class="kw">пусть</span> a = <span class="num">0</span>
    <span class="kw">пусть</span> b = <span class="num">1</span>
    <span class="kw">пока</span> истина {
        <span class="kw">выдать</span> a
        <span class="kw">пусть</span> c = a + b
        a = b
        b = c
    }
}

<span class="kw">пусть</span> счётчик = <span class="num">0</span>
<span class="kw">для</span> n <span class="kw">в</span> <span class="fn">фибо</span>() {
    <span class="fn">лог</span>(n)
    счётчик += <span class="num">1</span>
    <span class="kw">если</span> счётчик >= <span class="num">10</span> { <span class="kw">прервать</span> }
}</code></pre>

<h2>Цепочки методов</h2>
<pre><code><span class="kw">функция</span> <span class="fn">чётные</span>(макс) {
    <span class="kw">для</span> i <span class="kw">от</span> <span class="num">0</span> <span class="kw">до</span> макс + <span class="num">1</span> {
        <span class="kw">если</span> i % <span class="num">2</span> == <span class="num">0</span> { <span class="kw">выдать</span> i }
    }
}

<span class="fn">лог</span>(<span class="fn">чётные</span>(<span class="num">10</span>).<span class="fn">карта</span>(<span class="kw">функ</span>(x) { <span class="kw">вернуть</span> x * x }))
<span class="cmt">// [0, 4, 16, 36, 64, 100]</span></code></pre>

<h2>Зачем нужны</h2>
<ul>
  <li>Экономия памяти на больших данных.</li>
  <li>Бесконечные последовательности без остановки.</li>
  <li>Ленивые вычисления — работа делается только при обходе.</li>
</ul>
"""
    вернуть страница("Генераторы", "/генераторы", контент)
})

// ================================================================
// ASYNC
// ================================================================
app.маршрут("/async", "GET", функция(з) {
    пусть контент = """
<h1>Async / await</h1>
<p class="subtitle">Настоящий параллелизм через потоки.</p>

<h2>Асинхронная функция</h2>
<pre><code><span class="kw">асинхронно функция</span> <span class="fn">скачать</span>(url) {
    <span class="kw">пусть</span> r = <span class="kw">ждать</span> http_запрос(url)
    <span class="kw">вернуть</span> r
}

<span class="kw">пусть</span> данные = <span class="kw">ждать</span> <span class="fn">скачать</span>(<span class="str">"https://api.site/data"</span>)</code></pre>

<h2>Параллельно — ждать_все</h2>
<pre><code><span class="kw">асинхронно функция</span> <span class="fn">медленно</span>(имя, сек) {
    <span class="fn">спать</span>(сек)
    <span class="kw">вернуть</span> <span class="str">"готово-"</span> + имя
}

<span class="cmt">// три задачи параллельно — 1 сек вместо 3</span>
<span class="kw">пусть</span> результаты = <span class="kw">ждать_все</span>([
    <span class="fn">медленно</span>(<span class="str">"A"</span>, <span class="num">1</span>),
    <span class="fn">медленно</span>(<span class="str">"B"</span>, <span class="num">1</span>),
    <span class="fn">медленно</span>(<span class="str">"C"</span>, <span class="num">1</span>),
])</code></pre>

<h2>Реальный кейс — параллельные HTTP</h2>
<pre><code><span class="kw">пусть</span> requests = <span class="fn">подключить_питон</span>(<span class="str">"requests"</span>)

<span class="kw">асинхронно функция</span> <span class="fn">получить</span>(url) {
    <span class="kw">пусть</span> r = <span class="kw">ждать</span> requests.get(url)
    <span class="kw">вернуть</span> r.json()
}

<span class="kw">пусть</span> репы = <span class="kw">ждать_все</span>([
    <span class="fn">получить</span>(<span class="str">"https://api.github.com/repos/python/cpython"</span>),
    <span class="fn">получить</span>(<span class="str">"https://api.github.com/repos/django/django"</span>),
])</code></pre>

<h2>Ждать первую</h2>
<pre><code><span class="kw">пусть</span> быстрый = <span class="kw">ждать_первую</span>([
    <span class="fn">медленно</span>(<span class="str">"A"</span>, <span class="num">3</span>),
    <span class="fn">медленно</span>(<span class="str">"B"</span>, <span class="num">1</span>),
    <span class="fn">медленно</span>(<span class="str">"C"</span>, <span class="num">2</span>),
])   <span class="cmt">// вернёт B через 1 сек</span></code></pre>

<h2>Когда использовать</h2>
<ul>
  <li>Много сетевых запросов параллельно.</li>
  <li>Работа с файлами без блокировки UI.</li>
  <li>Фоновые задачи в веб-приложении.</li>
</ul>
<p><strong>Важно:</strong> GIL в Python не даёт параллелить CPU-задачи. Async ускоряет только I/O — сеть, диск.</p>
"""
    вернуть страница("Async / await", "/async", контент)
})

// ================================================================
// PATTERN MATCHING
// ================================================================
app.маршрут("/совпадает", "GET", функция(з) {
    пусть контент = """
<h1>Pattern matching</h1>
<p class="subtitle">Сопоставление с образцом вместо длинных if-else.</p>

<h2>Литералы</h2>
<pre><code><span class="kw">совпадает</span> x {
    <span class="kw">случай</span> <span class="num">0</span> { <span class="fn">лог</span>(<span class="str">"ноль"</span>) }
    <span class="kw">случай</span> <span class="num">1</span> { <span class="fn">лог</span>(<span class="str">"один"</span>) }
    <span class="kw">случай</span> <span class="str">"привет"</span> { <span class="fn">лог</span>(<span class="str">"приветствие"</span>) }
    <span class="kw">иначе</span> { <span class="fn">лог</span>(<span class="str">"другое"</span>) }
}</code></pre>

<h2>Списки с распаковкой</h2>
<pre><code><span class="kw">функция</span> <span class="fn">разобрать</span>(p) {
    <span class="kw">совпадает</span> p {
        <span class="kw">случай</span> [] { <span class="kw">вернуть</span> <span class="str">"пусто"</span> }
        <span class="kw">случай</span> [x] { <span class="kw">вернуть</span> <span class="str">"одно: "</span> + x }
        <span class="kw">случай</span> [x, y] { <span class="kw">вернуть</span> <span class="str">"два: "</span> + x + <span class="str">", "</span> + y }
        <span class="kw">иначе</span> { <span class="kw">вернуть</span> <span class="str">"много"</span> }
    }
}</code></pre>

<h2>Словари</h2>
<pre><code><span class="kw">совпадает</span> человек {
    <span class="kw">случай</span> {<span class="str">"имя"</span>: имя, <span class="str">"возраст"</span>: возраст} {
        <span class="fn">лог</span>(имя + <span class="str">", "</span> + возраст + <span class="str">" лет"</span>)
    }
    <span class="kw">случай</span> {<span class="str">"имя"</span>: имя} {
        <span class="fn">лог</span>(имя + <span class="str">", возраст неизвестен"</span>)
    }
    <span class="kw">иначе</span> {
        <span class="fn">лог</span>(<span class="str">"не человек"</span>)
    }
}</code></pre>

<h2>Wildcard</h2>
<pre><code><span class="kw">функция</span> <span class="fn">факториал</span>(n) {
    <span class="kw">совпадает</span> n {
        <span class="kw">случай</span> <span class="num">0</span> { <span class="kw">вернуть</span> <span class="num">1</span> }
        <span class="kw">случай</span> _ { <span class="kw">вернуть</span> n * <span class="fn">факториал</span>(n - <span class="num">1</span>) }
    }
}</code></pre>
"""
    вернуть страница("Pattern matching", "/совпадает", контент)
})

// ================================================================
// ДЕКОРАТОРЫ
// ================================================================
app.маршрут("/декораторы", "GET", функция(з) {
    пусть контент = """
<h1>Декораторы</h1>
<p class="subtitle">Оборачивай функции без изменения тела.</p>

<h2>Встроенные</h2>
<pre><code><span class="cmt">// Кеширование</span>
<span class="kw">@кешировать</span>
<span class="kw">функция</span> <span class="fn">тяжёлая</span>(n) {
    <span class="fn">спать</span>(<span class="num">0.5</span>)
    <span class="kw">вернуть</span> n * n
}

<span class="fn">тяжёлая</span>(<span class="num">5</span>)   <span class="cmt">// 0.5 сек</span>
<span class="fn">тяжёлая</span>(<span class="num">5</span>)   <span class="cmt">// мгновенно, из кеша</span></code></pre>

<pre><code><span class="cmt">// Повторить при ошибке</span>
<span class="kw">@повторить</span>(<span class="num">3</span>)
<span class="kw">функция</span> <span class="fn">нестабильно</span>() {
    <span class="kw">вернуть</span> <span class="fn">запрос_к_api</span>()
}</code></pre>

<pre><code><span class="cmt">// Замер времени</span>
<span class="kw">@таймер_декоратор</span>
<span class="kw">функция</span> <span class="fn">сортировка</span>(lst) {
    <span class="kw">вернуть</span> lst.<span class="fn">сортировать</span>()
}
<span class="cmt">// [таймер] сортировка: 12.34 мс</span></code></pre>

<pre><code><span class="cmt">// Логирование</span>
<span class="kw">@логировать</span>
<span class="kw">функция</span> <span class="fn">удвоить</span>(x) { <span class="kw">вернуть</span> x * <span class="num">2</span> }

<span class="cmt">// [лог] вызов удвоить((21,))</span>
<span class="cmt">// [лог] -> 42</span></code></pre>

<h2>Цепочка</h2>
<pre><code><span class="kw">@кешировать</span>
<span class="kw">@таймер_декоратор</span>
<span class="kw">функция</span> <span class="fn">комбо</span>(x) {
    <span class="fn">спать</span>(<span class="num">0.1</span>)
    <span class="kw">вернуть</span> x + <span class="num">100</span>
}</code></pre>

<h2>Когда использовать</h2>
<ul>
  <li><code>@кешировать</code> — для дорогих функций с повторяющимися аргументами.</li>
  <li><code>@повторить(n)</code> — для нестабильных сетевых вызовов.</li>
  <li><code>@таймер_декоратор</code> — при оптимизации.</li>
  <li><code>@логировать</code> — при отладке.</li>
</ul>
"""
    вернуть страница("Декораторы", "/декораторы", контент)
})

// ================================================================
// СТАНДАРТНАЯ БИБЛИОТЕКА
// ================================================================
app.маршрут("/модули", "GET", функция(з) {
    пусть контент = """
<h1>Стандартная библиотека</h1>
<p class="subtitle">Всё встроено, импортов не нужно.</p>

<h2>Строки</h2>
<pre><code><span class="str">"привет"</span>.<span class="fn">заглавные</span>()       <span class="cmt">// "ПРИВЕТ"</span>
<span class="str">"a,b,c"</span>.<span class="fn">разделить</span>(<span class="str">","</span>)     <span class="cmt">// ["a", "b", "c"]</span>
<span class="str">"abc"</span>.<span class="fn">заменить</span>(<span class="str">"b"</span>, <span class="str">"X"</span>) <span class="cmt">// "aXc"</span>
<span class="str">"abcdef"</span>.<span class="fn">первые</span>(<span class="num">3</span>)        <span class="cmt">// "abc"</span>
<span class="str">"42"</span>.<span class="fn">в_число</span>()             <span class="cmt">// 42</span>
<span class="str">"abc"</span>.<span class="fn">палиндром</span>()          <span class="cmt">// ложь</span>
<span class="str">"a,b,c"</span>.<span class="fn">разделить</span>(<span class="str">","</span>).<span class="fn">соединить</span>(<span class="str">" | "</span>)  <span class="cmt">// "a | b | c"</span></code></pre>

<h2>Списки и коллекции</h2>
<pre><code><span class="kw">пусть</span> lst = [<span class="num">3</span>, <span class="num">1</span>, <span class="num">4</span>, <span class="num">1</span>, <span class="num">5</span>]
lst.<span class="fn">сумма</span>()                   <span class="cmt">// 14</span>
lst.<span class="fn">сортировать</span>()            <span class="cmt">// [1, 1, 3, 4, 5]</span>
lst.<span class="fn">уникальные</span>()             <span class="cmt">// [3, 1, 4, 5]</span>
lst.<span class="fn">среднее</span>()                <span class="cmt">// 2.8</span>
lst.<span class="fn">содержит</span>(<span class="num">4</span>)              <span class="cmt">// истина</span>
lst.<span class="fn">срез</span>(<span class="num">1</span>, <span class="num">4</span>)              <span class="cmt">// [1, 4, 1]</span>
[[<span class="num">1</span>, [<span class="num">2</span>, <span class="num">3</span>]], [<span class="num">4</span>]].<span class="fn">плоский</span>() <span class="cmt">// [1, 2, 3, 4]</span>
[<span class="num">1</span>,<span class="num">2</span>,<span class="num">3</span>,<span class="num">4</span>,<span class="num">5</span>,<span class="num">6</span>].<span class="fn">разбить</span>(<span class="num">2</span>)   <span class="cmt">// [[1,2],[3,4],[5,6]]</span></code></pre>

<h2>JSON</h2>
<pre><code><span class="kw">пусть</span> obj = {<span class="str">"имя"</span>: <span class="str">"Алиса"</span>, <span class="str">"возраст"</span>: <span class="num">30</span>}
<span class="kw">пусть</span> строка = <span class="fn">json_создать</span>(obj)
<span class="kw">пусть</span> назад = <span class="fn">json_разобрать</span>(строка)

<span class="fn">json_писать</span>(<span class="str">"data.json"</span>, obj)
<span class="kw">пусть</span> из_файла = <span class="fn">json_читать</span>(<span class="str">"data.json"</span>)</code></pre>

<h2>Файлы</h2>
<pre><code><span class="fn">писать_файл</span>(<span class="str">"test.txt"</span>, <span class="str">"привет"</span>)
<span class="fn">добавить_файл</span>(<span class="str">"test.txt"</span>, <span class="str">"\nпока"</span>)
<span class="kw">пусть</span> текст = <span class="fn">читать_файл</span>(<span class="str">"test.txt"</span>)
<span class="kw">пусть</span> строки = <span class="fn">прочитать_строки</span>(<span class="str">"test.txt"</span>)
<span class="kw">пусть</span> все = <span class="fn">список_файлов</span>(<span class="str">"."</span>)</code></pre>

<h2>Дата и время</h2>
<pre><code><span class="fn">дата_сейчас</span>()                  <span class="cmt">// "2026-09-12 14:30:00"</span>
<span class="fn">дата_по_русски</span>()               <span class="cmt">// "12 сентября 2026, суббота"</span>
<span class="fn">сколько_назад</span>(ts)              <span class="cmt">// "2 часа назад"</span>
<span class="fn">склонение_с_числом</span>(<span class="num">5</span>, <span class="str">"яблоко"</span>, <span class="str">"яблока"</span>, <span class="str">"яблок"</span>)
<span class="fn">сейчас</span>()                       <span class="cmt">// timestamp</span>
<span class="fn">спать</span>(<span class="num">1.5</span>)                    <span class="cmt">// пауза</span></code></pre>

<h2>Регекспы</h2>
<pre><code><span class="fn">регексп_совпадает</span>(<span class="str">"^\\d+$"</span>, <span class="str">"12345"</span>)   <span class="cmt">// истина</span>
<span class="fn">регексп_все</span>(<span class="str">"\\d+"</span>, <span class="str">"10 и 20 и 30"</span>)      <span class="cmt">// ["10", "20", "30"]</span>
<span class="fn">регексп_заменить</span>(<span class="str">"\\d+"</span>, <span class="str">"N"</span>, <span class="str">"a1b2c3"</span>) <span class="cmt">// "aNbNcN"</span>
<span class="fn">регексп_полное_совпадение</span>(<span class="str">"^\\w+@\\w+\\.[a-z]+$"</span>, <span class="str">"a@b.ru"</span>)</code></pre>

<h2>Хэши и крипто</h2>
<pre><code><span class="fn">md5</span>(<span class="str">"привет"</span>)                    <span class="cmt">// 32 hex-символа</span>
<span class="fn">sha256</span>(<span class="str">"привет"</span>)                 <span class="cmt">// 64 hex-символа</span>
<span class="fn">base64_кодировать</span>(<span class="str">"привет"</span>)      <span class="cmt">// "0L/RgNC40LLQtdGC"</span>

<span class="kw">пусть</span> хеш = <span class="fn">хеш_пароля</span>(<span class="str">"секрет"</span>)
<span class="fn">проверить_пароль</span>(<span class="str">"секрет"</span>, хеш)  <span class="cmt">// истина</span>

<span class="kw">пусть</span> токен = <span class="fn">jwt_создать</span>({<span class="str">"user_id"</span>: <span class="num">42</span>}, <span class="str">"secret"</span>, <span class="num">3600</span>)
<span class="kw">пусть</span> данные = <span class="fn">jwt_разобрать</span>(токен, <span class="str">"secret"</span>)</code></pre>

<h2>Русские утилиты</h2>
<pre><code><span class="fn">транслит</span>(<span class="str">"Привет"</span>)               <span class="cmt">// "Privet"</span>
<span class="fn">заголовок</span>(<span class="str">"skyforge крутой"</span>)     <span class="cmt">// "Skyforge Крутой"</span>
<span class="fn">обрезать_до</span>(<span class="str">"длинный текст"</span>, <span class="num">6</span>)  <span class="cmt">// "длин..."</span>
<span class="fn">склонение</span>(<span class="num">2</span>, <span class="str">"год"</span>, <span class="str">"года"</span>, <span class="str">"лет"</span>) <span class="cmt">// "года"</span>
<span class="fn">нормализовать</span>(<span class="str">"  а   б  "</span>)       <span class="cmt">// "а б"</span></code></pre>

<h2>Случайности</h2>
<pre><code><span class="fn">случайное_целое</span>(<span class="num">1</span>, <span class="num">100</span>)
<span class="fn">случайное_дробное</span>(<span class="num">0</span>, <span class="num">1</span>)
<span class="fn">выбрать</span>([<span class="str">"а"</span>, <span class="str">"б"</span>])
<span class="fn">перемешать</span>([<span class="num">1</span>, <span class="num">2</span>, <span class="num">3</span>])
<span class="fn">uuid4</span>()                     <span class="cmt">// уникальный ID</span>
<span class="fn">случайные_буквы</span>(<span class="num">16</span>)</code></pre>
"""
    вернуть страница("Стандартная библиотека", "/модули", контент)
})

// ================================================================
// PYTHON-МОСТ
// ================================================================
app.маршрут("/питон", "GET", функция(з) {
    пусть контент = """
<h1>Python-мост</h1>
<p class="subtitle">Весь PyPI доступен в одну строку.</p>

<h2>Базовое использование</h2>
<pre><code><span class="kw">пусть</span> requests = <span class="fn">подключить_питон</span>(<span class="str">"requests"</span>)
<span class="kw">пусть</span> r = requests.get(<span class="str">"https://api.github.com/repos/python/cpython"</span>)
<span class="fn">лог</span>(r.json()[<span class="str">"stargazers_count"</span>])</code></pre>

<h2>Вложенные модули</h2>
<p>Для точечного имени возвращается корневой модуль, чтобы привычная иерархия работала:</p>
<pre><code><span class="kw">пусть</span> os = <span class="fn">подключить_питон</span>(<span class="str">"os.path"</span>)
<span class="kw">пусть</span> путь = os.path.join(<span class="str">"папка"</span>, <span class="str">"файл.txt"</span>)

<span class="kw">пусть</span> datetime = <span class="fn">подключить_питон</span>(<span class="str">"datetime"</span>)
<span class="kw">пусть</span> сейчас = datetime.datetime.now()
<span class="fn">лог</span>(сейчас.year, сейчас.month)</code></pre>

<h2>Установка пакетов из кода</h2>
<pre><code><span class="fn">установить_пакет</span>(<span class="str">"numpy"</span>)
<span class="kw">пусть</span> np = <span class="fn">подключить_питон</span>(<span class="str">"numpy"</span>)
<span class="kw">пусть</span> a = np.array([<span class="num">1</span>, <span class="num">2</span>, <span class="num">3</span>])
<span class="fn">лог</span>(a.mean())</code></pre>

<h2>Десктоп через tkinter</h2>
<pre><code><span class="kw">пусть</span> tk = <span class="fn">подключить_питон</span>(<span class="str">"tkinter"</span>)
<span class="kw">пусть</span> root = tk.Tk()
root.title(<span class="str">"Моё приложение"</span>)
root.geometry(<span class="str">"400x300"</span>)

<span class="kw">пусть</span> label = tk.Label(root, text = <span class="str">"Привет!"</span>)
label.pack()

root.mainloop()</code></pre>

<h2>Что доступно</h2>
<div class="grid">
  <div class="card"><h3>HTTP</h3><p>requests, httpx, aiohttp</p></div>
  <div class="card"><h3>Парсинг</h3><p>beautifulsoup4, lxml, html5lib</p></div>
  <div class="card"><h3>Data Science</h3><p>numpy, pandas, scipy, matplotlib</p></div>
  <div class="card"><h3>ML/AI</h3><p>openai, torch, transformers, anthropic</p></div>
  <div class="card"><h3>Telegram</h3><p>aiogram, python-telegram-bot</p></div>
  <div class="card"><h3>Desktop</h3><p>tkinter, PyQt5, PySide6, customtkinter</p></div>
  <div class="card"><h3>PostgreSQL</h3><p>psycopg2, asyncpg</p></div>
  <div class="card"><h3>Redis</h3><p>redis-py</p></div>
</div>
"""
    вернуть страница("Python-мост", "/питон", контент)
})

// ================================================================
// ВЕБ-ФРЕЙМВОРК
// ================================================================
app.маршрут("/веб", "GET", функция(з) {
    пусть контент = """
<h1>Веб-фреймворк</h1>
<p class="subtitle">Маршруты, шаблоны, middleware, сессии.</p>

<h2>Hello, web!</h2>
<pre><code><span class="kw">пусть</span> app = <span class="fn">приложение</span>()

app.<span class="fn">маршрут</span>(<span class="str">"/"</span>, <span class="str">"GET"</span>, <span class="kw">функция</span>(з) {
    <span class="kw">вернуть</span> <span class="str">"&lt;h1&gt;Привет, мир!&lt;/h1&gt;"</span>
})

app.<span class="fn">запустить</span>(<span class="num">8000</span>)</code></pre>

<pre><code>SkyForge web app.skf
<span class="cmt"># или</span>
SkyForge GAZUY app.skf</code></pre>

<h2>Параметры маршрута</h2>
<pre><code>app.<span class="fn">маршрут</span>(<span class="str">"/users/&lt;id:int&gt;"</span>, <span class="str">"GET"</span>, <span class="kw">функция</span>(з) {
    <span class="kw">пусть</span> id = з[<span class="str">"параметры_маршрута"</span>][<span class="str">"id"</span>]
    <span class="kw">вернуть</span> {<span class="str">"id"</span>: id}
})

<span class="cmt">// со строкой</span>
app.<span class="fn">маршрут</span>(<span class="str">"/пост/&lt;slug&gt;"</span>, <span class="str">"GET"</span>, <span class="kw">функция</span>(з) {
    <span class="kw">вернуть</span> <span class="str">"Пост: "</span> + з[<span class="str">"параметры_маршрута"</span>][<span class="str">"slug"</span>]
})</code></pre>

<h2>Объект запроса</h2>
<pre><code>з[<span class="str">"метод"</span>]              <span class="cmt">// "GET" / "POST"</span>
з[<span class="str">"путь"</span>]              <span class="cmt">// "/users/42"</span>
з[<span class="str">"параметры"</span>]         <span class="cmt">// {"имя": "Алиса"} — query</span>
з[<span class="str">"json"</span>]              <span class="cmt">// тело как dict (если POST с JSON)</span>
з[<span class="str">"тело"</span>]              <span class="cmt">// тело как строка</span>
з[<span class="str">"заголовки"</span>]         <span class="cmt">// заголовки запроса</span>
з[<span class="str">"параметры_маршрута"</span>] <span class="cmt">// параметры из &lt;id&gt;</span>
з[<span class="str">"сессия"</span>]            <span class="cmt">// сессионные данные</span></code></pre>

<h2>Возврат</h2>
<pre><code><span class="kw">вернуть</span> <span class="str">"&lt;h1&gt;HTML&lt;/h1&gt;"</span>          <span class="cmt">// text/html</span>
<span class="kw">вернуть</span> {<span class="str">"ок"</span>: истина}             <span class="cmt">// JSON</span>
<span class="kw">вернуть</span> [<span class="num">1</span>, <span class="num">2</span>, <span class="num">3</span>]                <span class="cmt">// JSON-массив</span>
<span class="kw">вернуть</span> app.<span class="fn">json_ответ</span>(данные, <span class="num">201</span>)  <span class="cmt">// явный JSON</span>
<span class="kw">вернуть</span> app.<span class="fn">редирект</span>(<span class="str">"/новый"</span>)
<span class="kw">вернуть</span> app.<span class="fn">ошибка</span>(<span class="str">"Не найдено"</span>, <span class="num">404</span>)</code></pre>

<h2>Шаблоны</h2>
<pre><code><span class="kw">вернуть</span> app.<span class="fn">страница</span>(<span class="str">"index.html"</span>, {
    <span class="str">"имя"</span>: <span class="str">"Алиса"</span>,
    <span class="str">"товары"</span>: [<span class="str">"хлеб"</span>, <span class="str">"молоко"</span>]
})</code></pre>

<p>Внутри шаблона — подстановки <code>&#123;&#123; var &#125;&#125;</code> и блоки <code>&#123;% %&#125;</code>:</p>
<pre><code>&lt;h1&gt;Привет, &#123;&#123; имя &#125;&#125;&lt;/h1&gt;
&lt;ul&gt;
&#123;% для т в товары %&#125;
  &lt;li&gt;&#123;&#123; т &#125;&#125;&lt;/li&gt;
&#123;% конец %&#125;
&lt;/ul&gt;

&#123;% если имя == "Алиса" %&#125;
  &lt;p&gt;Это админ&lt;/p&gt;
&#123;% иначе %&#125;
  &lt;p&gt;Гость&lt;/p&gt;
&#123;% конец %&#125;</code></pre>

<p>Или шаблон из строки:</p>
<pre><code><span class="kw">вернуть</span> app.<span class="fn">шаблон_из</span>(<span class="str">"&lt;h1&gt;Привет, &#123;&#123; имя &#125;&#125;&lt;/h1&gt;"</span>, {<span class="str">"имя"</span>: <span class="str">"Мир"</span>})</code></pre>

<h2>Middleware</h2>
<pre><code>app.<span class="fn">использовать</span>(<span class="kw">функция</span>(з, след) {
    <span class="fn">лог</span>(<span class="str">"["</span> + з[<span class="str">"метод"</span>] + <span class="str">"] "</span> + з[<span class="str">"путь"</span>])
    <span class="kw">вернуть</span> <span class="fn">след</span>(з)
})

<span class="cmt">// защита админки</span>
app.<span class="fn">использовать</span>(<span class="kw">функция</span>(з, след) {
    <span class="kw">если</span> з[<span class="str">"путь"</span>].<span class="fn">начало_с</span>(<span class="str">"/admin"</span>) {
        <span class="kw">если</span> не з[<span class="str">"сессия"</span>].<span class="fn">получить</span>(<span class="str">"вошёл"</span>) {
            <span class="kw">вернуть</span> app.<span class="fn">редирект</span>(<span class="str">"/вход"</span>)
        }
    }
    <span class="kw">вернуть</span> <span class="fn">след</span>(з)
})</code></pre>

<h2>Сессии</h2>
<pre><code>app.<span class="fn">секрет_сессий</span>(<span class="str">"супер-секретный-ключ"</span>)

app.<span class="fn">маршрут</span>(<span class="str">"/вход"</span>, <span class="str">"POST"</span>, <span class="kw">функция</span>(з) {
    з[<span class="str">"сессия"</span>][<span class="str">"вошёл"</span>] = истина
    з[<span class="str">"сессия"</span>][<span class="str">"имя"</span>] = з[<span class="str">"json"</span>][<span class="str">"имя"</span>]
    <span class="kw">вернуть</span> {<span class="str">"ок"</span>: истина}
})

app.<span class="fn">маршрут</span>(<span class="str">"/выход"</span>, <span class="str">"GET"</span>, <span class="kw">функция</span>(з) {
    з[<span class="str">"сессия"</span>].<span class="fn">очистить</span>()
    <span class="kw">вернуть</span> app.<span class="fn">редирект</span>(<span class="str">"/"</span>)
})</code></pre>

<h2>Автодокументация</h2>
<p>Все маршруты доступны на <code>/docs</code>:</p>
<pre><code>http://localhost:8000/docs</code></pre>

<h2>Статика</h2>
<pre><code>app.<span class="fn">статика</span>(<span class="str">"/static"</span>, <span class="str">"public"</span>)
<span class="cmt">// /static/style.css → public/style.css</span></code></pre>

<h2>Деплой на Render</h2>
<pre><code><span class="cmt"># render.yaml</span>
services:
  - type: web
    runtime: python
    plan: free
    buildCommand: pip install skyforge-lang
    startCommand: SkyForge GAZUY app.skf
    envVars:
      - key: SKYFORGE_HOST
        value: 0.0.0.0
      - key: PYTHONUNBUFFERED
        value: "1"
    healthCheckPath: /health</code></pre>
"""
    вернуть страница("Веб-фреймворк", "/веб", контент)
})

// ================================================================
// ORM
// ================================================================
app.маршрут("/orm", "GET", функция(з) {
    пусть контент = """
<h1>ORM</h1>
<p class="subtitle">Модели и запросы к SQLite без SQL.</p>

<h2>Модель</h2>
<pre><code><span class="kw">пусть</span> бд = <span class="fn">бд_открыть</span>(<span class="str">"app.db"</span>)

<span class="kw">пусть</span> Пользователи = <span class="fn">создать_модель</span>(
    имя = <span class="str">"Пользователь"</span>,
    таблица = <span class="str">"users"</span>,
    бд = бд,
    поля = [
        {<span class="str">"имя"</span>: <span class="str">"id"</span>, <span class="str">"тип"</span>: <span class="str">"целое"</span>, <span class="str">"первичный"</span>: истина, <span class="str">"авто"</span>: истина},
        {<span class="str">"имя"</span>: <span class="str">"имя"</span>, <span class="str">"тип"</span>: <span class="str">"строка"</span>, <span class="str">"не_пусто"</span>: истина},
        {<span class="str">"имя"</span>: <span class="str">"возраст"</span>, <span class="str">"тип"</span>: <span class="str">"целое"</span>, <span class="str">"по_умолчанию"</span>: <span class="num">0</span>},
        {<span class="str">"имя"</span>: <span class="str">"город"</span>, <span class="str">"тип"</span>: <span class="str">"строка"</span>}
    ]
)

Пользователи.<span class="fn">создать_таблицу</span>()</code></pre>

<h2>CRUD</h2>
<pre><code><span class="cmt">// создать</span>
<span class="kw">пусть</span> алиса = Пользователи.<span class="fn">создать</span>(имя = <span class="str">"Алиса"</span>, возраст = <span class="num">30</span>, город = <span class="str">"Москва"</span>)

<span class="cmt">// получить по id</span>
<span class="kw">пусть</span> найденный = Пользователи.<span class="fn">получить</span>(алиса.id)

<span class="cmt">// обновить</span>
алиса.<span class="fn">обновить</span>(город = <span class="str">"Питер"</span>)

<span class="cmt">// удалить</span>
алиса.<span class="fn">удалить</span>()

<span class="cmt">// всё</span>
<span class="kw">пусть</span> все = Пользователи.<span class="fn">все</span>()

<span class="cmt">// количество</span>
<span class="fn">лог</span>(Пользователи.<span class="fn">количество</span>())

<span class="cmt">// очистить</span>
Пользователи.<span class="fn">очистить</span>()</code></pre>

<h2>Запросы</h2>
<pre><code><span class="cmt">// где с параметрами</span>
<span class="kw">пусть</span> москвичи = Пользователи.<span class="fn">где</span>(<span class="str">'"город" = ?'</span>, [<span class="str">"Москва"</span>])
<span class="kw">пусть</span> взрослые = Пользователи.<span class="fn">где</span>(<span class="str">'"возраст" >= ?'</span>, [<span class="num">18</span>])

<span class="cmt">// сортировка и цепочка</span>
<span class="kw">пусть</span> топ = Пользователи
    .<span class="fn">где</span>(<span class="str">'"возраст" > ?'</span>, [<span class="num">20</span>])
    .<span class="fn">сортировать</span>(<span class="str">"возраст"</span>, обратно = истина)
    .<span class="fn">первые</span>(<span class="num">5</span>)

<span class="cmt">// агрегация</span>
взрослые.<span class="fn">количество</span>()          <span class="cmt">// сколько</span>
взрослые.<span class="fn">сумма</span>(<span class="str">"возраст"</span>)         <span class="cmt">// сумма</span>
взрослые.<span class="fn">среднее</span>(<span class="str">"возраст"</span>)       <span class="cmt">// среднее</span>
взрослые.<span class="fn">карта</span>(<span class="str">"имя"</span>)            <span class="cmt">// список имён</span>

<span class="cmt">// один результат</span>
<span class="kw">пусть</span> один = Пользователи.<span class="fn">один_где</span>(<span class="str">'"имя" = ?'</span>, [<span class="str">"Алиса"</span>])</code></pre>

<h2>Типы полей</h2>
<div class="card">
<p><span class="tag">целое</span> INTEGER</p>
<p><span class="tag">число</span> REAL</p>
<p><span class="tag">строка</span> TEXT</p>
<p><span class="tag">булево</span> INTEGER (0/1)</p>
<p><span class="tag">json</span> TEXT</p>
</div>

<h2>Опции полей</h2>
<ul>
  <li><code>"первичный": истина</code> — PRIMARY KEY</li>
  <li><code>"авто": истина</code> — AUTOINCREMENT</li>
  <li><code>"не_пусто": истина</code> — NOT NULL</li>
  <li><code>"уникальное": истина</code> — UNIQUE</li>
  <li><code>"по_умолчанию": значение</code> — DEFAULT</li>
</ul>
"""
    вернуть страница("ORM", "/orm", контент)
})

// ================================================================
// GUI
// ================================================================
app.маршрут("/gui", "GET", функция(з) {
    пусть контент = """
<h1>Десктоп / GUI</h1>
<p class="subtitle">Приложения с окнами через Python-мост.</p>

<p>SkyForge не имеет своего GUI-фреймворка, но через <code>подключить_питон</code> можно использовать любой: <code>tkinter</code>, <code>customtkinter</code>, <code>PyQt5</code>, <code>PySide6</code>.</p>

<h2>Минимальное окно</h2>
<pre><code><span class="kw">пусть</span> tk = <span class="fn">подключить_питон</span>(<span class="str">"tkinter"</span>)

<span class="kw">пусть</span> root = tk.Tk()
root.title(<span class="str">"Моё приложение"</span>)
root.geometry(<span class="str">"400x300"</span>)

<span class="kw">пусть</span> label = tk.Label(root, text = <span class="str">"Привет, мир!"</span>)
label.pack()

root.mainloop()</code></pre>

<h2>Поле + кнопка + реакция</h2>
<pre><code><span class="kw">пусть</span> tk = <span class="fn">подключить_питон</span>(<span class="str">"tkinter"</span>)

<span class="kw">пусть</span> root = tk.Tk()
root.title(<span class="str">"Приветствие"</span>)
root.geometry(<span class="str">"400x250"</span>)

<span class="kw">пусть</span> поле = tk.Entry(root)
поле.pack(pady = <span class="num">10</span>)

<span class="kw">пусть</span> результат = tk.Label(root, text = <span class="str">""</span>, font = (<span class="str">"Arial"</span>, <span class="num">14</span>))
результат.pack(pady = <span class="num">10</span>)

<span class="kw">функция</span> <span class="fn">поздороваться</span>() {
    <span class="kw">пусть</span> имя = поле.get()
    результат.configure(text = <span class="str">"Привет, "</span> + имя + <span class="str">"!"</span>)
}

<span class="kw">пусть</span> кнопка = tk.Button(root, text = <span class="str">"Поздороваться"</span>, command = поздороваться)
кнопка.pack(pady = <span class="num">5</span>)

root.mainloop()</code></pre>

<h2>Калькулятор (2 числа)</h2>
<pre><code><span class="kw">пусть</span> tk = <span class="fn">подключить_питон</span>(<span class="str">"tkinter"</span>)

<span class="kw">пусть</span> root = tk.Tk()
root.title(<span class="str">"Калькулятор"</span>)
root.geometry(<span class="str">"400x250"</span>)

<span class="kw">пусть</span> a = tk.Entry(root)
a.pack(pady = <span class="num">8</span>)

<span class="kw">пусть</span> b = tk.Entry(root)
b.pack(pady = <span class="num">8</span>)

<span class="kw">пусть</span> итог = tk.Label(root, text = <span class="str">""</span>, font = (<span class="str">"Arial"</span>, <span class="num">16</span>))
итог.pack(pady = <span class="num">10</span>)

<span class="kw">функция</span> <span class="fn">посчитать</span>() {
    <span class="kw">пусть</span> x = число(a.get())
    <span class="kw">пусть</span> y = число(b.get())
    итог.configure(text = <span class="str">"Сумма: "</span> + (x + y))
}

tk.Button(root, text = <span class="str">"="</span>, command = посчитать, width = <span class="num">20</span>).pack()

root.mainloop()</code></pre>

<h2>Тёмная тема через customtkinter</h2>
<pre><code><span class="fn">установить_пакет</span>(<span class="str">"customtkinter"</span>)
<span class="kw">пусть</span> ctk = <span class="fn">подключить_питон</span>(<span class="str">"customtkinter"</span>)

ctk.set_appearance_mode(<span class="str">"dark"</span>)
ctk.set_default_color_theme(<span class="str">"blue"</span>)

<span class="kw">пусть</span> app = ctk.CTk()
app.title(<span class="str">"Красивое окно"</span>)
app.geometry(<span class="str">"500x350"</span>)

<span class="kw">пусть</span> label = ctk.CTkLabel(app, text = <span class="str">"Привет!"</span>, font = (<span class="str">"Arial"</span>, <span class="num">20</span>))
label.pack(pady = <span class="num">30</span>)

<span class="kw">пусть</span> field = ctk.CTkEntry(app, placeholder_text = <span class="str">"Введи имя"</span>)
field.pack(pady = <span class="num">10</span>)

<span class="kw">функция</span> <span class="fn">показать</span>() {
    label.configure(text = <span class="str">"Привет, "</span> + field.get() + <span class="str">"!"</span>)
}

btn = ctk.CTkButton(app, text = <span class="str">"Поздороваться"</span>, command = показать)
btn.pack(pady = <span class="num">10</span>)

app.mainloop()</code></pre>

<h2>Запуск</h2>
<pre><code>SkyForge run app.skf</code></pre>

<h2>Что дальше</h2>
<ul>
  <li><code>customtkinter</code> — современный вид, тёмная тема, скруглённые элементы.</li>
  <li><code>PySide6</code> — мощный, как Qt, для больших приложений.</li>
  <li>Сборка в <code>.exe</code> — через <code>nuitka</code> или <code>pyinstaller</code>.</li>
</ul>

<div class="card">
  <h3>Совет</h3>
  <p>Начинай с <code>tkinter</code> — он встроен, не требует установки. Когда понадобится красота — переходи на <code>customtkinter</code>.</p>
</div>
"""
    вернуть страница("Десктоп / GUI", "/gui", контент)
})

// ================================================================
// ТЕСТИРОВАНИЕ
// ================================================================
app.маршрут("/тесты", "GET", функция(з) {
    пусть контент = """
<h1>Тестирование</h1>
<p class="subtitle">Декоратор <code>@тест</code> + ассерты + красивый отчёт.</p>

<h2>Простой тест</h2>
<pre><code><span class="kw">@тест</span>(<span class="str">"сложение работает"</span>)
<span class="kw">функция</span> <span class="fn">т1</span>() {
    <span class="fn">ожидать_равно</span>(<span class="num">2</span> + <span class="num">2</span>, <span class="num">4</span>)
}

<span class="kw">@тест</span>(<span class="str">"строка переворачивается"</span>)
<span class="kw">функция</span> <span class="fn">т2</span>() {
    <span class="fn">ожидать_равно</span>(<span class="str">"abc"</span>.<span class="fn">обратить</span>(), <span class="str">"cba"</span>)
}

<span class="fn">запустить_тесты</span>()</code></pre>

<h2>Ассерты</h2>
<pre><code><span class="fn">ожидать</span>(условие, <span class="str">"сообщение"</span>)
<span class="fn">ожидать_равно</span>(a, b)
<span class="fn">ожидать_не_равно</span>(a, b)
<span class="fn">ожидать_истина</span>(v)
<span class="fn">ожидать_ложь</span>(v)
<span class="fn">ожидать_содержит</span>(коллекция, элемент)
<span class="fn">ожидать_ошибку</span>(<span class="kw">функ</span>() { <span class="cmt">/* код, который бросает */</span> })</code></pre>

<h2>Проверка ошибок</h2>
<pre><code><span class="kw">@тест</span>(<span class="str">"деление на ноль бросает"</span>)
<span class="kw">функция</span> <span class="fn">т3</span>() {
    <span class="fn">ожидать_ошибку</span>(<span class="kw">функ</span>() { <span class="kw">вернуть</span> <span class="num">1</span> / <span class="num">0</span> })
}</code></pre>

<h2>Запуск через CLI</h2>
<pre><code>SkyForge test tests.skf</code></pre>

<h2>Вывод</h2>
<pre><code>═══════════════════════════════════════════════════════════
  Запуск 3 тестов
═══════════════════════════════════════════════════════════
  ✅ сложение работает                        0.02 мс
  ✅ строка переворачивается                  0.01 мс
  ✅ деление на ноль бросает                  0.03 мс
═══════════════════════════════════════════════════════════
  Итого: 3 ✅  0 ❌  из 3
  🎉 Все тесты пройдены
═══════════════════════════════════════════════════════════</code></pre>

<h2>Полный пример</h2>
<pre><code><span class="kw">пусть</span> бд = <span class="fn">бд_открыть</span>(<span class="str">":memory:"</span>)
<span class="kw">пусть</span> Users = <span class="fn">создать_модель</span>(
    имя = <span class="str">"User"</span>, таблица = <span class="str">"users"</span>, бд = бд,
    поля = [
        {<span class="str">"имя"</span>: <span class="str">"id"</span>, <span class="str">"тип"</span>: <span class="str">"целое"</span>, <span class="str">"первичный"</span>: истина, <span class="str">"авто"</span>: истина},
        {<span class="str">"имя"</span>: <span class="str">"имя"</span>, <span class="str">"тип"</span>: <span class="str">"строка"</span>}
    ]
)
Users.<span class="fn">создать_таблицу</span>()

<span class="kw">@тест</span>(<span class="str">"создание пользователя"</span>)
<span class="kw">функция</span> <span class="fn">т_создать</span>() {
    <span class="kw">пусть</span> u = Users.<span class="fn">создать</span>(имя = <span class="str">"Тест"</span>)
    <span class="fn">ожидать</span>(u.id > <span class="num">0</span>, <span class="str">"id должен быть > 0"</span>)
}

<span class="kw">@тест</span>(<span class="str">"поиск по имени"</span>)
<span class="kw">функция</span> <span class="fn">т_поиск</span>() {
    <span class="kw">пусть</span> u = Users.<span class="fn">один_где</span>(<span class="str">'"имя" = ?'</span>, [<span class="str">"Тест"</span>])
    <span class="fn">ожидать_равно</span>(u.имя, <span class="str">"Тест"</span>)
}

<span class="fn">запустить_тесты</span>()
бд_закрыть(бд)</code></pre>
"""
    вернуть страница("Тестирование", "/тесты", контент)
})

// ================================================================
// РЕЦЕПТЫ
// ================================================================
app.маршрут("/рецепты", "GET", функция(з) {
    пусть контент = """
<h1>Рецепты</h1>
<p class="subtitle">Готовые сниппеты для типовых задач.</p>

<h2>1. Парсинг CSV и отчёт</h2>
<pre><code><span class="kw">пусть</span> строки = <span class="fn">csv_читать</span>(<span class="str">"продажи.csv"</span>)
<span class="kw">пусть</span> итог = {}

<span class="kw">для</span> s <span class="kw">в</span> строки[<span class="num">1</span>:] {
    <span class="kw">пусть</span> город = s[<span class="num">2</span>]
    итог[город] = итог.<span class="fn">получить</span>(город, <span class="num">0</span>) + <span class="fn">целое</span>(s[<span class="num">3</span>])
}

<span class="kw">для</span> п <span class="kw">в</span> итог.<span class="fn">элементы</span>().<span class="fn">сортировать_по</span>(<span class="kw">функ</span>(x) { <span class="kw">вернуть</span> -x[<span class="num">1</span>] }) {
    <span class="fn">лог</span>(п[<span class="num">0</span>], <span class="str">":"</span>, п[<span class="num">1</span>])
}</code></pre>

<h2>2. HTTP-запрос с повторами</h2>
<pre><code><span class="kw">пусть</span> requests = <span class="fn">подключить_питон</span>(<span class="str">"requests"</span>)

<span class="kw">@повторить</span>(<span class="num">3</span>)
<span class="kw">функция</span> <span class="fn">получить</span>(url) {
    <span class="kw">пусть</span> r = requests.get(url, timeout = <span class="num">10</span>)
    r.raise_for_status()
    <span class="kw">вернуть</span> r.json()
}

<span class="kw">пусть</span> данные = <span class="fn">получить</span>(<span class="str">"https://api.site/users"</span>)</code></pre>

<h2>3. Рекурсивная сортировка файлов по расширению</h2>
<pre><code><span class="kw">пусть</span> shutil = <span class="fn">подключить_питон</span>(<span class="str">"shutil"</span>)
<span class="kw">пусть</span> папка = <span class="fn">ввод</span>(<span class="str">"Папка: "</span>)

<span class="kw">для</span> f <span class="kw">в</span> <span class="fn">список_файлов</span>(папка) {
    <span class="kw">пусть</span> ext = <span class="fn">расширение</span>(f).<span class="fn">обрезать</span>(<span class="str">"."</span>)
    <span class="kw">если</span> ext == <span class="str">""</span> { ext = <span class="str">"без_расширения"</span> }
    <span class="fn">создать_папку</span>(<span class="fn">объединить_путь</span>(папка, ext))
    shutil.move(<span class="fn">объединить_путь</span>(папка, f), <span class="fn">объединить_путь</span>(папка, ext, f))
}</code></pre>

<h2>4. Парсер сайтов через bs4</h2>
<pre><code><span class="fn">установить_пакет</span>(<span class="str">"requests"</span>)
<span class="fn">установить_пакет</span>(<span class="str">"beautifulsoup4"</span>)

<span class="kw">пусть</span> requests = <span class="fn">подключить_питон</span>(<span class="str">"requests"</span>)
<span class="kw">пусть</span> bs4 = <span class="fn">подключить_питон</span>(<span class="str">"bs4"</span>)

<span class="kw">пусть</span> html = requests.get(<span class="str">"https://news.site"</span>).text
<span class="kw">пусть</span> soup = bs4.BeautifulSoup(html, <span class="str">"html.parser"</span>)

<span class="kw">для</span> h <span class="kw">в</span> soup.find_all(<span class="str">"h2"</span>) {
    <span class="fn">лог</span>(h.text)
}</code></pre>

<h2>5. Telegram-бот через aiogram</h2>
<pre><code><span class="fn">установить_пакет</span>(<span class="str">"aiogram"</span>)
<span class="kw">пусть</span> aiogram = <span class="fn">подключить_питон</span>(<span class="str">"aiogram"</span>)
<span class="kw">пусть</span> asyncio = <span class="fn">подключить_питон</span>(<span class="str">"asyncio"</span>)

<span class="kw">пусть</span> bot = aiogram.Bot(<span class="str">"ТОКЕН"</span>)
<span class="kw">пусть</span> dp = aiogram.Dispatcher()

<span class="cmt">// ... обработчики</span>

asyncio.run(dp.start_polling(bot))</code></pre>

<h2>6. Генерация отчёта в HTML</h2>
<pre><code><span class="kw">пусть</span> данные = [
    {<span class="str">"имя"</span>: <span class="str">"Алиса"</span>, <span class="str">"продажи"</span>: <span class="num">1500</span>},
    {<span class="str">"имя"</span>: <span class="str">"Боб"</span>, <span class="str">"продажи"</span>: <span class="num">2300</span>}
]

<span class="kw">пусть</span> строки = <span class="str">""</span>
<span class="kw">для</span> ч <span class="kw">в</span> данные {
    строки = строки + <span class="str">"&lt;tr&gt;&lt;td&gt;"</span> + ч[<span class="str">"имя"</span>] + <span class="str">"&lt;/td&gt;&lt;td&gt;"</span> + ч[<span class="str">"продажи"</span>] + <span class="str">"&lt;/td&gt;&lt;/tr&gt;"</span>
}

<span class="fn">писать_файл</span>(<span class="str">"отчёт.html"</span>,
    <span class="str">"&lt;table&gt;&lt;tr&gt;&lt;th&gt;Имя&lt;/th&gt;&lt;th&gt;Продажи&lt;/th&gt;&lt;/tr&gt;"</span> + строки + <span class="str">"&lt;/table&gt;"</span>)</code></pre>

<h2>7. Sitemap и robots.txt для сайта</h2>
<pre><code>app.<span class="fn">маршрут</span>(<span class="str">"/sitemap.xml"</span>, <span class="str">"GET"</span>, <span class="kw">функция</span>(з) {
    <span class="kw">пусть</span> urls = [<span class="str">"/"</span>, <span class="str">"/о-нас"</span>, <span class="str">"/контакты"</span>]
    <span class="kw">пусть</span> xml = <span class="str">"&lt;?xml version='1.0'?&gt;&lt;urlset&gt;"</span>
    <span class="kw">для</span> u <span class="kw">в</span> urls {
        xml = xml + <span class="str">"&lt;url&gt;&lt;loc&gt;https://сайт.ру"</span> + u + <span class="str">"&lt;/loc&gt;&lt;/url&gt;"</span>
    }
    xml = xml + <span class="str">"&lt;/urlset&gt;"</span>
    <span class="kw">вернуть</span> (<span class="num">200</span>, <span class="str">"application/xml"</span>, xml)
})</code></pre>

<h2>8. Кеширование тяжёлых вычислений</h2>
<pre><code><span class="kw">@кешировать</span>
<span class="kw">функция</span> <span class="fn">фибо</span>(n) {
    <span class="kw">если</span> n <= <span class="num">1</span> { <span class="kw">вернуть</span> n }
    <span class="kw">вернуть</span> <span class="fn">фибо</span>(n - <span class="num">1</span>) + <span class="fn">фибо</span>(n - <span class="num">2</span>)
}

<span class="fn">лог</span>(<span class="fn">фибо</span>(<span class="num">100</span>))   <span class="cmt">// мгновенно благодаря кешу</span></code></pre>

<h2>9. Таймер выполнения</h2>
<pre><code><span class="kw">@таймер_декоратор</span>
<span class="kw">функция</span> <span class="fn">тяжёлая_операция</span>() {
    <span class="fn">спать</span>(<span class="num">2</span>)
}

<span class="fn">тяжёлая_операция</span>()
<span class="cmt">// [таймер] тяжёлая_операция: 2001.23 мс</span></code></pre>

<h2>10. Чтение и запись JSON-конфига</h2>
<pre><code><span class="kw">пусть</span> конфиг = {}
<span class="kw">если</span> <span class="fn">существует</span>(<span class="str">"config.json"</span>) {
    конфиг = <span class="fn">json_читать</span>(<span class="str">"config.json"</span>)
} <span class="kw">иначе</span> {
    конфиг = {<span class="str">"порт"</span>: <span class="num">8000</span>, <span class="str">"отладка"</span>: ложь}
    <span class="fn">json_писать</span>(<span class="str">"config.json"</span>, конфиг)
}

<span class="fn">лог</span>(<span class="str">"Порт:"</span>, конфиг[<span class="str">"порт"</span>])</code></pre>
"""
    вернуть страница("Рецепты", "/рецепты", контент)
})

// ================================================================
// ШПАРГАЛКА
// ================================================================
app.маршрут("/шпаргалка", "GET", функция(з) {
    пусть контент = """
<h1>Шпаргалка</h1>
<p class="subtitle">Весь синтаксис на одной странице.</p>

<h2>Основы</h2>
<pre><code><span class="kw">пусть</span> x = <span class="num">5</span>                <span class="cmt">// объявление</span>
x = <span class="num">10</span>                    <span class="cmt">// переприсваивание</span>
x += <span class="num">1</span>                    <span class="cmt">// инкремент</span>

<span class="cmt">// типы</span>
<span class="kw">пусть</span> n = <span class="num">42</span>              <span class="cmt">// целое</span>
<span class="kw">пусть</span> f = <span class="num">3.14</span>            <span class="cmt">// дробное</span>
<span class="kw">пусть</span> s = <span class="str">"привет"</span>        <span class="cmt">// строка</span>
<span class="kw">пусть</span> b = истина           <span class="cmt">// булево</span>
<span class="kw">пусть</span> lst = [<span class="num">1</span>, <span class="num">2</span>, <span class="num">3</span>]     <span class="cmt">// список</span>
<span class="kw">пусть</span> d = {<span class="str">"a"</span>: <span class="num">1</span>}        <span class="cmt">// словарь</span>
<span class="kw">пусть</span> s = <span class="fn">множество</span>([<span class="num">1</span>, <span class="num">2</span>]) <span class="cmt">// множество</span>
<span class="kw">пусть</span> n = ничего           <span class="cmt">// null</span></code></pre>

<h2>Условия</h2>
<pre><code><span class="kw">если</span> x > <span class="num">0</span> { ... }
<span class="kw">если</span> x > <span class="num">0</span> { ... } <span class="kw">иначе</span> { ... }
<span class="kw">если</span> x > <span class="num">0</span> { ... } <span class="kw">иначе если</span> x == <span class="num">0</span> { ... } <span class="kw">иначе</span> { ... }

<span class="cmt">// тернарник</span>
<span class="kw">пусть</span> статус = x > <span class="num">0</span> <span class="kw">если</span> <span class="str">"плюс"</span> <span class="kw">иначе</span> <span class="str">"минус"</span></code></pre>

<h2>Циклы</h2>
<pre><code><span class="kw">для</span> i <span class="kw">от</span> <span class="num">0</span> <span class="kw">до</span> <span class="num">10</span> { ... }
<span class="kw">для</span> i <span class="kw">от</span> <span class="num">0</span> <span class="kw">до</span> <span class="num">100</span> <span class="kw">шаг</span> <span class="num">5</span> { ... }
<span class="kw">для</span> x <span class="kw">в</span> [<span class="num">1</span>, <span class="num">2</span>, <span class="num">3</span>] { ... }
<span class="kw">для</span> k, v <span class="kw">в</span> словарь.<span class="fn">элементы</span>() { ... }
<span class="kw">пока</span> условие { ... }

<span class="kw">прервать</span>       <span class="cmt">// break</span>
<span class="kw">продолжить</span>     <span class="cmt">// continue</span></code></pre>

<h2>Функции</h2>
<pre><code><span class="kw">функция</span> <span class="fn">имя</span>(a, b) { <span class="kw">вернуть</span> a + b }
<span class="kw">функция</span> <span class="fn">имя</span>(a, b = <span class="num">5</span>) { ... }       <span class="cmt">// дефолт</span>
<span class="kw">функция</span> <span class="fn">имя</span>(a: <span class="type">число</span>) -> <span class="type">число</span> { ... } <span class="cmt">// типы</span>

<span class="fn">имя</span>(<span class="num">1</span>, <span class="num">2</span>)          <span class="cmt">// позиционно</span>
<span class="fn">имя</span>(a = <span class="num">1</span>, b = <span class="num">2</span>)    <span class="cmt">// именованно</span>

<span class="cmt">// лямбда</span>
<span class="kw">пусть</span> f = <span class="kw">функ</span>(x) { <span class="kw">вернуть</span> x * <span class="num">2</span> }</code></pre>

<h2>Классы</h2>
<pre><code><span class="kw">класс</span> <span class="type">Имя</span> {
    поле = <span class="num">0</span>                      <span class="cmt">// атрибут класса</span>

    <span class="kw">функция</span> <span class="fn">инициализация</span>(a) {
        <span class="kw">это</span>.a = a
    }
    <span class="kw">функция</span> <span class="fn">метод</span>() { ... }
}

<span class="kw">класс</span> <span class="type">Наследник</span> <span class="kw">наследник</span> <span class="type">Имя</span> {
    <span class="kw">функция</span> <span class="fn">метод</span>() {
        <span class="kw">пусть</span> x = <span class="fn">супер</span>.<span class="fn">метод</span>()
    }
}

<span class="kw">пусть</span> объект = <span class="type">Имя</span>(<span class="num">5</span>)
объект.<span class="fn">метод</span>()</code></pre>

<h2>Коллекции</h2>
<pre><code><span class="kw">пусть</span> lst = [<span class="num">1</span>, <span class="num">2</span>, <span class="num">3</span>]
lst[<span class="num">0</span>]           <span class="cmt">// 1</span>
lst[<span class="num">1</span>:<span class="num">3</span>]         <span class="cmt">// [2, 3]</span>
lst[::-<span class="num">1</span>]         <span class="cmt">// [3, 2, 1]</span>
lst.<span class="fn">длина</span>()       <span class="cmt">// 3</span>
lst.<span class="fn">сумма</span>()       <span class="cmt">// 6</span>
lst.<span class="fn">сортировать</span>() <span class="cmt">// [1, 2, 3]</span>
lst.<span class="fn">уникальные</span>()  <span class="cmt">// убрать дубли</span>
lst.<span class="fn">содержит</span>(<span class="num">2</span>)  <span class="cmt">// истина</span>

<span class="kw">пусть</span> d = {<span class="str">"a"</span>: <span class="num">1</span>}
d[<span class="str">"a"</span>]              <span class="cmt">// 1</span>
d[<span class="str">"b"</span>] = <span class="num">2</span>          <span class="cmt">// добавить</span>
d.<span class="fn">ключи</span>()          <span class="cmt">// ["a", "b"]</span>
d.<span class="fn">получить</span>(<span class="str">"нет"</span>, <span class="num">0</span>) <span class="cmt">// 0</span></code></pre>

<h2>Строки</h2>
<pre><code><span class="str">"привет"</span>.<span class="fn">заглавные</span>()          <span class="cmt">// "ПРИВЕТ"</span>
<span class="str">"a,b,c"</span>.<span class="fn">разделить</span>(<span class="str">","</span>)        <span class="cmt">// ["a","b","c"]</span>
[<span class="str">"a"</span>,<span class="str">"b"</span>].<span class="fn">соединить</span>(<span class="str">"-"</span>)        <span class="cmt">// "a-b"</span>
<span class="str">"abc"</span>.<span class="fn">заменить</span>(<span class="str">"b"</span>, <span class="str">"X"</span>)    <span class="cmt">// "aXc"</span>
<span class="str">"abcdef"</span>.<span class="fn">первые</span>(<span class="num">3</span>)           <span class="cmt">// "abc"</span>
<span class="str">"abc"</span>.<span class="fn">повторить</span>(<span class="num">3</span>)           <span class="cmt">// "abcabcabc"</span>
<span class="str">"{имя}"</span>                    <span class="cmt">// интерполяция</span>
<span class="str">"abc"</span>.<span class="fn">палиндром</span>()           <span class="cmt">// ложь</span></code></pre>

<h2>Исключения</h2>
<pre><code><span class="kw">попробовать</span> { ... } <span class="kw">поймать</span> e { ... }
<span class="kw">попробовать</span> { ... } <span class="kw">поймать</span> e { ... } <span class="kw">наконец</span> { ... }
<span class="kw">бросить</span> <span class="str">"сообщение"</span>

<span class="kw">проверить</span> условие, <span class="str">"сообщение"</span></code></pre>

<h2>Специальный синтаксис</h2>
<pre><code><span class="cmt">// включения</span>
[x * <span class="num">2</span> <span class="kw">для</span> x <span class="kw">в</span> список]
[x <span class="kw">для</span> x <span class="kw">в</span> список <span class="kw">если</span> x > <span class="num">0</span>]
{k: v <span class="kw">для</span> k, v <span class="kw">в</span> словарь.<span class="fn">элементы</span>()}

<span class="cmt">// генератор</span>
<span class="kw">функция</span> <span class="fn">ген</span>() { <span class="kw">выдать</span> <span class="num">1</span>; <span class="kw">выдать</span> <span class="num">2</span> }

<span class="cmt">// async</span>
<span class="kw">асинхронно функция</span> <span class="fn">ф</span>() { <span class="kw">вернуть</span> <span class="kw">ждать</span> что-то() }
<span class="kw">ждать_все</span>([задача1, задача2])

<span class="cmt">// pattern matching</span>
<span class="kw">совпадает</span> x {
    <span class="kw">случай</span> <span class="num">0</span> { ... }
    <span class="kw">случай</span> [a, b] { ... }
    <span class="kw">иначе</span> { ... }
}

<span class="cmt">// декораторы</span>
<span class="kw">@кешировать</span>
<span class="kw">@повторить</span>(<span class="num">3</span>)
<span class="kw">@таймер_декоратор</span>
<span class="kw">@логировать</span></code></pre>

<h2>Команды CLI</h2>
<pre><code>SkyForge repl                    <span class="cmt"># REPL</span>
SkyForge run app.skf             <span class="cmt"># запуск</span>
SkyForge GAZUY app.skf           <span class="cmt"># с баннером</span>
SkyForge check app.skf           <span class="cmt"># синтаксис</span>
SkyForge test tests.skf          <span class="cmt"># тесты</span>
SkyForge web app.skf --port 8000 <span class="cmt"># web</span>
SkyForge gui                     <span class="cmt"># GUI-лаунчер</span>
SkyForge version                 <span class="cmt"># версия</span></code></pre>
"""
    вернуть страница("Шпаргалка", "/шпаргалка", контент)
})

