    вернуть страница("Дорожная карта", "/дорожная-карта", контент)
})

// ================================================================
// СЛУЖЕБНЫЕ МАРШРУТЫ
// ================================================================
app.маршрут("/github", "GET", функция(з) {
    вернуть app.редирект(РЕПО)
})

app.маршрут("/health", "GET", функция(з) {
    вернуть "ok"
})

app.маршрут("/heal", "GET", функция(з) {
    вернуть {
        "статус": "живой",
        "версия": ВЕРСИЯ,
        "время": дата_сейчас()
    }
})

app.маршрут("/sitemap.xml", "GET", функция(з) {
    пусть urls = []
    для группа в NAV {
        для пункт в группа[1] {
            urls.добавить("  &lt;url&gt;&lt;loc&gt;https://skyforge-docs.onrender.com" + пункт[0] + "&lt;/loc&gt;&lt;/url&gt;")
        }
    }
    вернуть (200, "application/xml; charset=utf-8",
        "&lt;?xml version='1.0' encoding='UTF-8'?&gt;\n&lt;urlset xmlns='http://www.sitemaps.org/schemas/sitemap/0.9'&gt;\n"
        + urls.соединить("\n") + "\n&lt;/urlset&gt;")
})

app.маршрут("/favicon.ico", "GET", функция(з) {
    пусть svg = '&lt;svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"&gt;&lt;rect width="64" height="64" rx="14" fill="#8b6cff"/&gt;&lt;text x="32" y="46" text-anchor="middle" font-family="Arial" font-size="40" font-weight="bold" fill="#fff"&gt;S&lt;/text&gt;&lt;/svg&gt;'
    вернуть (200, "image/svg+xml", svg)
})

// ================================================================
// 404
// ================================================================
app.маршрут("/<path>", "GET", функция(з) {
    пусть контент = """
<h1>404 — не найдено</h1>
<p>Такой страницы нет.</p>
<p><a href="/">← Вернуться на главную</a></p>
"""
    вернуть app.ошибка(страница("404", "/", контент), 404)
})

// ================================================================
// Самопинг, чтобы Render не засыпал
// ================================================================
пусть старт_время = сейчас()
пусть self_url = окружение("RENDER_EXTERNAL_URL")

если self_url != ничего {
    лог("🔁 Самопинг включён:", self_url, "/heal")
    поток(функция() {
        пока истина {
            спать(600)
            попробовать {
                пусть r = http_запрос(self_url + "/heal")
                лог("[пинг]", дата_сейчас(), "->", r.первые(40))
            } поймать e {
                лог("[пинг] ошибка:", e)
            }
        }
    })
} иначе {
    лог("ℹ️  RENDER_EXTERNAL_URL не найден — самопинг выключен (норма для локальной разработки)")
}

// ================================================================
// Запуск
// ================================================================
лог("📚 SkyForge Documentation v2")
лог("   Порт:", порт_сервера())
лог("   Хост:", хост_сервера())
лог("   Открой: http://localhost:" + порт_сервера() + "/")

app.запустить(порт_сервера(), блокировать = истина)
