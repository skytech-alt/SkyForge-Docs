// ================================================================
// SkyForge Documentation — сайт документации на самом SkyForge
// ================================================================

пусть app = приложение()
app.имя("SkyForge — документация")
app.отладка(истина)

// ----------------------------------------------------------------
// CSS (инлайн — не нужны внешние файлы)
// ----------------------------------------------------------------
пусть CSS = """
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: 'Segoe UI', system-ui, sans-serif; background: #0f1117;
       color: #e6e9f2; line-height: 1.6; }
a { color: #9b83ff; text-decoration: none; }
a:hover { text-decoration: underline; }

.layout { display: flex; min-height: 100vh; }

.sidebar { width: 260px; background: #161923; padding: 24px 0;
           border-right: 1px solid #2a2f45; position: sticky; top: 0;
           height: 100vh; overflow-y: auto; }
.sidebar .logo { padding: 0 24px 24px; font-size: 22px; font-weight: 800;
                 color: #9b83ff; letter-spacing: -0.5px; }
.sidebar .logo small { display: block; font-size: 11px; color: #8b93a7;
                       font-weight: 400; margin-top: 4px; }
.nav-group { padding: 8px 24px 4px; font-size: 11px; text-transform: uppercase;
             color: #8b93a7; letter-spacing: 1px; font-weight: 700; }
.nav-item { display: block; padding: 8px 24px; color: #c8cce0; font-size: 14px;
            border-left: 2px solid transparent; }
.nav-item:hover { background: #1d2130; text-decoration: none; }
.nav-item.active { color: #9b83ff; background: #1d2130;
                   border-left-color: #7c5cff; }

.content { flex: 1; padding: 48px 56px; max-width: 900px; }
.content h1 { font-size: 34px; margin-bottom: 8px; color: #fff;
              letter-spacing: -0.5px; }
.content h1 + p.subtitle { color: #8b93a7; margin-bottom: 32px; font-size: 16px; }
.content h2 { font-size: 24px; margin: 40px 0 16px; color: #fff; }
.content h3 { font-size: 18px; margin: 24px 0 12px; color: #dcdcaa; }
.content p { margin-bottom: 12px; }
.content ul, .content ol { margin: 12px 0 12px 24px; }
.content li { margin-bottom: 6px; }

pre { background: #0b0d13; border: 1px solid #2a2f45; border-radius: 8px;
      padding: 16px 20px; overflow-x: auto; margin: 16px 0;
      font-family: 'Consolas', 'JetBrains Mono', monospace; font-size: 13px;
      line-height: 1.6; }
code { background: #1d2130; padding: 2px 8px; border-radius: 4px;
       font-family: 'Consolas', monospace; font-size: 13px; color: #c586c0; }
pre code { background: none; padding: 0; color: #e6e9f2; }

.kw { color: #c586c0; } .str { color: #ce9178; } .num { color: #b5cea8; }
.cmt { color: #6a9955; } .fn { color: #dcdcaa; } .type { color: #4ec9b0; }

.card { background: #161923; border: 1px solid #2a2f45; border-radius: 10px;
        padding: 20px 24px; margin: 16px 0; }
.card h3 { margin-top: 0; }
.tag { display: inline-block; background: #1d2130; color: #9b83ff;
       padding: 3px 10px; border-radius: 12px; font-size: 12px;
       margin-right: 6px; font-weight: 600; }
.badge { display: inline-block; background: #7c5cff; color: #fff;
         padding: 4px 12px; border-radius: 6px; font-size: 12px;
         font-weight: 700; margin-left: 12px; vertical-align: middle; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 16px; margin: 24px 0; }
.grid .card:hover { border-color: #7c5cff; }
hr { border: none; border-top: 1px solid #2a2f45; margin: 32px 0; }
.footer { padding: 24px 56px; border-top: 1px solid #2a2f45; color: #8b93a7;
          font-size: 13px; }
"""

// ----------------------------------------------------------------
// Навигация
// ----------------------------------------------------------------
пусть NAV = [
    ["Начало", [
        ["/", "Введение"],
        ["/установка", "Установка"],
    ]],
    ["Язык", [
        ["/синтаксис", "Синтаксис"],
        ["/функции", "Функции"],
        ["/классы", "Классы"],
        ["/включения", "Включения"],
        ["/исключения", "Исключения"],
        ["/типы", "Типы"],
        ["/генераторы", "Генераторы"],
        ["/async", "Async / await"],
        ["/совпадает", "Pattern matching"],
        ["/декораторы", "Декораторы"],
    ]],
    ["Экосистема", [
        ["/модули", "Стандартная библиотека"],
        ["/питон", "Python-мост"],
        ["/веб", "Веб-фреймворк"],
        ["/orm", "ORM"],
        ["/тесты", "Тестирование"],
    ]],
    ["Примеры", [
        ["/примеры", "Готовые программы"],
    ]],
]

// ----------------------------------------------------------------
// Общий каркас
// ----------------------------------------------------------------
функция страница(заголовок, путь, содержимое) {
    // строим сайдбар
    пусть меню = ""
    для группа в NAV {
        меню = меню + '<div class="nav-group">' + группа[0] + '</div>'
        для пункт в группа[1] {
            пусть cls = "nav-item"
            если пункт[0] == путь { cls = "nav-item active" }
            меню = меню + '<a class="' + cls + '" href="' + пункт[0] + '">' + пункт[1] + '</a>'
        }
    }

    вернуть app.шаблон_из("""
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ заголовок }} — SkyForge</title>
  <style>{{ CSS }}</style>
</head>
<body>
<div class="layout">
  <aside class="sidebar">
    <div class="logo">
      SkyForge
      <small>русскоязычный язык программирования</small>
    </div>
    {{ меню }}
  </aside>
  <main class="content">
    {{ содержимое }}
    <hr>
    <p style="color:#8b93a7;font-size:13px">
      SkyForge v1.0.0 <a href="https://pypi.org/project/skyforge-lang/">PyPI</a>
      · <a href="https://github.com/">GitHub</a>
    </p>
  </main>
</div>
</body>
</html>
""", {
        "заголовок": заголовок,
        "CSS": CSS,
        "меню": меню,
        "содержимое": содержимое
    })
}

// ----------------------------------------------------------------
// Главная
// ----------------------------------------------------------------
app.маршрут("/", "GET", функция(з) {
    пусть контент = """
<h1>SkyForge <span class="badge">v1.0.0</span></h1>
<p class="subtitle">Русскоязычный язык программирования. Компактный, мощный, для реальных задач.</p>

<div class="card">
<h3>Установка</h3>
<pre><code>pip install skyforge-lang</code></pre>
</div>

<h2>Быстрый старт</h2>
<pre><code><span class="cmt">// hello.skf</span>
<span class="kw">функция</span> <span class="fn">привет</span>(имя) {
    <span class="kw">вернуть</span> <span class="str">"Привет, "</span> + имя + <span class="str">"!"</span>
}

<span class="fn">лог</span>(<span class="fn">привет</span>(<span class="str">"Мир"</span>))
</code></pre>

<pre><code>SkyForge run hello.skf
<span class="cmt"># Привет, Мир!</span></code></pre>

<h2>Что внутри</h2>
<div class="grid">
  <div class="card"><h3>Язык</h3>
    <p>Функции, классы, наследование, лямбды, включения, декораторы, генераторы, async/await, pattern matching, опциональные типы, исключения.</p></div>
  <div class="card"><h3>Стандартная библиотека</h3>
    <p>Строки, коллекции, JSON, CSV, файлы, дата/время, регекспы, хэши, base64, URL, крипто, склонения.</p></div>
  <div class="card"><h3>Веб-фреймворк</h3>
    <p>Маршруты, JSON API, шаблоны, статика, middleware, сессии, автодокументация <code>/docs</code>.</p></div>
  <div class="card"><h3>ORM</h3>
    <p>Модели, CRUD, запросы, сортировка, агрегация. SQLite из коробки.</p></div>
  <div class="card"><h3>Тесты</h3>
    <p>Декоратор <code>@тест("имя")</code>, ассерты, красивый отчёт, команда <code>SkyForge test</code>.</p></div>
  <div class="card"><h3>Python-мост</h3>
    <p><code>подключить_питон("numpy")</code> — весь PyPI доступен в одну строку.</p></div>
</div>

<h2>REPL</h2>
<pre><code>SkyForge repl
<span class="fn">SkyForge</span> ❯ <span class="kw">пусть</span> x = <span class="num">10</span>
<span class="fn">SkyForge</span> ❯ x * <span class="num">2</span>
<span class="num">20</span>
</code></pre>

<h2>Философия</h2>
<div class="card">
<p>Писать код так же естественно, как говорить. Русские ключевые слова, минимум символов, батарейки включены. Не замена Python — а инструмент для быстрых прототипов, скриптов, API и обучения.</p>
</div>
"""
    вернуть страница("Введение", "/", контент)
})

// ----------------------------------------------------------------
// Установка
// ----------------------------------------------------------------
app.маршрут("/установка", "GET", функция(з) {
    пусть контент = """
<h1>Установка</h1>
<p class="subtitle">Одна команда — и язык у тебя.</p>

<h2>Требования</h2>
<ul>
  <li>Python 3.9 или новее</li>
  <li>Windows, macOS или Linux</li>
</ul>

<h2>Через pip</h2>
<pre><code>pip install skyforge-lang</code></pre>

<h2>Проверка</h2>
<pre><code>SkyForge version
<span class="cmt"># SkyForge 1.0.0</span>
<span class="cmt"># Python: 3.12.0</span>
<span class="cmt"># Платформа: linux</span>
</code></pre>

<h2>Команды CLI</h2>
<div class="card">
<pre><code>SkyForge repl                      <span class="cmt"># интерактивная консоль</span>
SkyForge run app.skf               <span class="cmt"># запустить файл</span>
SkyForge GAZUY app.skf             <span class="cmt"># запустить с баннером</span>
SkyForge check app.skf             <span class="cmt"># проверить синтаксис</span>
SkyForge test tests.skf            <span class="cmt"># прогнать тесты</span>
SkyForge web app.skf --port 8000   <span class="cmt"># веб-приложение</span>
SkyForge gui                       <span class="cmt"># графический лаунчер</span></code></pre>
</div>

<h2>Из исходников</h2>
<pre><code>git clone https://github.com/твой-ник/skyforge
cd skyforge
pip install -e .</code></pre>

<h2>VS Code</h2>
<p>Пока нет официального расширения — используйте обычный редактор с подсветкой Python для базовой поддержки или встроенный <code>SkyForge gui</code>.</p>
"""
    вернуть страница("Установка", "/установка", контент)
})

// ----------------------------------------------------------------
// Синтаксис
// ----------------------------------------------------------------
app.маршрут("/синтаксис", "GET", функция(з) {
    пусть контент = """
<h1>Синтаксис</h1>
<p class="subtitle">Всё, что нужно знать для старта.</p>

<h2>Переменные</h2>
<pre><code><span class="kw">пусть</span> имя = <span class="str">"Алиса"</span>
<span class="kw">пусть</span> возраст = <span class="num">30</span>
возраст += <span class="num">1</span>       <span class="cmt">// 31</span>
</code></pre>

<h2>Вывод</h2>
<pre><code><span class="fn">лог</span>(<span class="str">"Привет"</span>)
<span class="fn">лог</span>(<span class="str">"Возраст: "</span> + возраст)
<span class="fn">лог</span>(<span class="str">"Через год: {возраст + 1}"</span>)   <span class="cmt">// интерполяция</span>
</code></pre>

<h2>Условия</h2>
<pre><code><span class="kw">если</span> оценка >= <span class="num">90</span> {
    <span class="fn">лог</span>(<span class="str">"Отлично"</span>)
} <span class="kw">иначе если</span> оценка >= <span class="num">75</span> {
    <span class="fn">лог</span>(<span class="str">"Хорошо"</span>)
} <span class="kw">иначе</span> {
    <span class="fn">лог</span>(<span class="str">"Надо поработать"</span>)
}
</code></pre>

<h2>Циклы</h2>
<pre><code><span class="kw">для</span> i <span class="kw">от</span> <span class="num">0</span> <span class="kw">до</span> <span class="num">10</span> {
    <span class="fn">лог</span>(i)
}

<span class="kw">для</span> i <span class="kw">от</span> <span class="num">0</span> <span class="kw">до</span> <span class="num">100</span> <span class="kw">шаг</span> <span class="num">5</span> {
    <span class="fn">лог</span>(i)
}

<span class="kw">для</span> x <span class="kw">в</span> [<span class="num">1</span>, <span class="num">2</span>, <span class="num">3</span>] {
    <span class="fn">лог</span>(x)
}

<span class="kw">пока</span> x < <span class="num">10</span> {
    x += <span class="num">1</span>
}
</code></pre>

<h2>Управление циклом</h2>
<pre><code><span class="kw">для</span> i <span class="kw">от</span> <span class="num">0</span> <span class="kw">до</span> <span class="num">10</span> {
    <span class="kw">если</span> i == <span class="num">3</span> { <span class="kw">продолжить</span> }
    <span class="kw">если</span> i > <span class="num">7</span> { <span class="kw">прервать</span> }
    <span class="fn">лог</span>(i)
}
</code></pre>

<h2>Тернарник</h2>
<pre><code><span class="kw">пусть</span> статус = возраст >= <span class="num">18</span> <span class="kw">если</span> <span class="str">"взрослый"</span> <span class="kw">иначе</span> <span class="str">"ребёнок"</span>
</code></pre>

<h2>Коллекции</h2>
<pre><code><span class="kw">пусть</span> lst = [<span class="num">1</span>, <span class="num">2</span>, <span class="num">3</span>]
<span class="kw">пусть</span> сл = {<span class="str">"имя"</span>: <span class="str">"Алиса"</span>, <span class="str">"возраст"</span>: <span class="num">30</span>}
<span class="kw">пусть</span> мн = <span class="fn">множество</span>([<span class="num">1</span>, <span class="num">2</span>, <span class="num">3</span>])

<span class="fn">лог</span>(lst[<span class="num">0</span>])           <span class="cmt">// 1</span>
<span class="fn">лог</span>(lst[<span class="num">1</span>:<span class="num">3</span>])         <span class="cmt">// [2, 3]</span>
<span class="fn">лог</span>(lst[::-<span class="num">1</span>])         <span class="cmt">// [3, 2, 1]</span>
<span class="fn">лог</span>(сл[<span class="str">"имя"</span>])          <span class="cmt">// Алиса</span>
</code></pre>
"""
    вернуть страница("Синтаксис", "/синтаксис", контент)
})

// ----------------------------------------------------------------
// Функции
// ----------------------------------------------------------------
app.маршрут("/функции", "GET", функция(з) {
    пусть контент = """
<h1>Функции</h1>
<p class="subtitle">Именованные, анонимные, с типами.</p>

<h2>Обычная функция</h2>
<pre><code><span class="kw">функция</span> <span class="fn">сумма</span>(a, b) {
    <span class="kw">вернуть</span> a + b
}

<span class="fn">лог</span>(<span class="fn">сумма</span>(<span class="num">2</span>, <span class="num">3</span>))   <span class="cmt">// 5</span>
</code></pre>

<h2>Дефолтные аргументы</h2>
<pre><code><span class="kw">функция</span> <span class="fn">привет</span>(имя, приветствие = <span class="str">"Привет"</span>) {
    <span class="kw">вернуть</span> приветствие + <span class="str">", "</span> + имя
}

<span class="fn">лог</span>(<span class="fn">привет</span>(<span class="str">"Алиса"</span>))                     <span class="cmt">// Привет, Алиса</span>
<span class="fn">лог</span>(<span class="fn">привет</span>(<span class="str">"Боб"</span>, <span class="str">"Здравствуй"</span>))         <span class="cmt">// Здравствуй, Боб</span>
</code></pre>

<h2>Именованные аргументы</h2>
<pre><code><span class="fn">привет</span>(имя = <span class="str">"Катя"</span>, приветствие = <span class="str">"Хай"</span>)
</code></pre>

<h2>Лямбды</h2>
<pre><code><span class="kw">пусть</span> удвоить = <span class="kw">функция</span>(x) { <span class="kw">вернуть</span> x * <span class="num">2</span> }
<span class="kw">пусть</span> утроить = <span class="kw">функ</span>(x) { <span class="kw">вернуть</span> x * <span class="num">3</span> }

<span class="fn">лог</span>(<span class="fn">удвоить</span>(<span class="num">21</span>))   <span class="cmt">// 42</span>
</code></pre>

<h2>Функции высшего порядка</h2>
<pre><code><span class="kw">пусть</span> числа = [<span class="num">1</span>, <span class="num">2</span>, <span class="num">3</span>, <span class="num">4</span>, <span class="num">5</span>]

<span class="fn">лог</span>(числа.<span class="fn">карта</span>(<span class="kw">функ</span>(x) { <span class="kw">вернуть</span> x * x }))
<span class="cmt">// [1, 4, 9, 16, 25]</span>

<span class="fn">лог</span>(числа.<span class="fn">фильтр</span>(<span class="kw">функ</span>(x) { <span class="kw">вернуть</span> x % <span class="num">2</span> == <span class="num">0</span> }))
<span class="cmt">// [2, 4]</span>
</code></pre>

<h2>Типы параметров и возврата</h2>
<pre><code><span class="kw">функция</span> <span class="fn">сумма</span>(a: <span class="type">число</span>, b: <span class="type">число</span>) -> <span class="type">число</span> {
    <span class="kw">вернуть</span> a + b
}

<span class="fn">сумма</span>(<span class="str">"2"</span>, <span class="str">"3"</span>)   <span class="cmt">// ошибка типа — поймается автоматически</span>
</code></pre>

<h2>Рекурсия</h2>
<pre><code><span class="kw">функция</span> <span class="fn">фибо</span>(n) {
    <span class="kw">если</span> n <= <span class="num">1</span> { <span class="kw">вернуть</span> n }
    <span class="kw">вернуть</span> <span class="fn">фибо</span>(n - <span class="num">1</span>) + <span class="fn">фибо</span>(n - <span class="num">2</span>)
}

<span class="fn">лог</span>(<span class="fn">фибо</span>(<span class="num">10</span>))   <span class="cmt">// 55</span>
</code></pre>
"""
    вернуть страница("Функции", "/функции", контент)
})

// ----------------------------------------------------------------
// Классы
// ----------------------------------------------------------------
app.маршрут("/классы", "GET", функция(з) {
    пусть контент = """
<h1>Классы</h1>
<p class="subtitle">ООП с наследованием и super.</p>

<h2>Простой класс</h2>
<pre><code><span class="kw">класс</span> <span class="type">Точка</span> {
    <span class="kw">функция</span> <span class="fn">инициализация</span>(x, y) {
        <span class="kw">это</span>.x = x
        <span class="kw">это</span>.y = y
    }

    <span class="kw">функция</span> <span class="fn">длина</span>() {
        <span class="kw">вернуть</span> <span class="fn">корень</span>(<span class="kw">это</span>.x * <span class="kw">это</span>.x + <span class="kw">это</span>.y * <span class="kw">это</span>.y)
    }
}

<span class="kw">пусть</span> p = <span class="type">Точка</span>(<span class="num">3</span>, <span class="num">4</span>)
<span class="fn">лог</span>(p.<span class="fn">длина</span>())   <span class="cmt">// 5.0</span>
</code></pre>

<h2>Наследование</h2>
<pre><code><span class="kw">класс</span> <span class="type">Животное</span> {
    <span class="kw">функция</span> <span class="fn">инициализация</span>(имя) { <span class="kw">это</span>.имя = имя }
    <span class="kw">функция</span> <span class="fn">говорить</span>() { <span class="kw">вернуть</span> <span class="str">"..."</span> }
}

<span class="kw">класс</span> <span class="type">Собака</span> <span class="kw">наследник</span> <span class="type">Животное</span> {
    <span class="kw">функция</span> <span class="fn">говорить</span>() { <span class="kw">вернуть</span> <span class="str">"Гав!"</span> }
}

<span class="kw">пусть</span> с = <span class="type">Собака</span>(<span class="str">"Шарик"</span>)
<span class="fn">лог</span>(с.<span class="fn">говорить</span>())   <span class="cmt">// Гав!</span>
</code></pre>

<h2>super — вызов родителя</h2>
<pre><code><span class="kw">класс</span> <span class="type">Кот</span> <span class="kw">наследник</span> <span class="type">Животное</span> {
    <span class="kw">функция</span> <span class="fn">говорить</span>() {
        <span class="kw">вернуть</span> <span class="fn">супер</span>.<span class="fn">говорить</span>() + <span class="str">" Мяу!"</span>
    }
}

<span class="fn">лог</span>(<span class="type">Кот</span>(<span class="str">"Барсик"</span>).<span class="fn">говорить</span>())   <span class="cmt">// ... Мяу!</span>
</code></pre>

<h2>Атрибуты класса</h2>
<pre><code><span class="kw">класс</span> <span class="type">Счётчик</span> {
    значение = <span class="num">0</span>

    <span class="kw">функция</span> <span class="fn">прибавить</span>(n) {
        <span class="kw">это</span>.значение += n
        <span class="kw">вернуть</span> <span class="kw">это</span>            <span class="cmt">// для цепочки</span>
    }
}

<span class="kw">пусть</span> c = <span class="type">Счётчик</span>()
c.<span class="fn">прибавить</span>(<span class="num">5</span>).<span class="fn">прибавить</span>(<span class="num">10</span>)
<span class="fn">лог</span>(c.значение)   <span class="cmt">// 15</span>
</code></pre>
"""
    вернуть страница("Классы", "/классы", контент)
})

