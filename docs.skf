app.маршрут("/llms.txt", "GET", функция(з) {
    пусть путь = "docs-app/llms.txt"
    если не существует(путь) { путь = "llms.txt" }
    если не существует(путь) {
        вернуть app.текст_ответ("llms.txt не найден", 500)
    }
    вернуть app.текст_ответ(читать_файл(путь, "utf-8"), 200)
})

// ================================================================
// СТАТИКА + 404
// ================================================================
app.маршрут("/<файл>", "GET", функция(з) {
    пусть имя = з["параметры_маршрута"]["файл"]

    если имя.содержит_подстроку("..") {
        вернуть app.ошибка("Недопустимый путь", 400)
    }

    // D-2: allowlist расширений. Иначе любой файл отдавался как text/plain,
    // включая сам docs.skf, .env, render.yaml.
    пусть РАЗРЕШ = [".html", ".htm", ".css", ".js", ".txt", ".xml",
                    ".json", ".svg", ".ico"]
    пусть низ = имя.строчные()
    пусть ок = ложь
    для р в РАЗРЕШ {
        если низ.конец_с(р) { ок = истина; прервать }
    }
    если не ок {
        вернуть app.текст_ответ("403 — файл этого типа не отдаётся", 403)
    }

    пусть путь = ничего
    для место в ["docs-app/", "", "docs-app/static/"] {
        пусть пробный = место + имя
        если существует(пробный) и это_файл(пробный) {
            путь = пробный
            прервать
        }
    }

    если путь == ничего {
        пусть контент404 = """
<h1>404 — не найдено</h1>
<p>Такой страницы нет.</p>
<p><a href="/">← Вернуться на главную</a></p>
"""
        вернуть app.ошибка(страница("404", "/", контент404), 404)
    }

    пусть расш = расширение(имя)

    если расш == ".html" или расш == ".htm" {
        вернуть app.html_ответ(читать_файл(путь, "utf-8"))
    }
    если расш == ".txt" {
        вернуть app.текст_ответ(читать_файл(путь, "utf-8"))
    }
    если расш == ".xml" {
        вернуть app.xml_ответ(читать_файл(путь, "utf-8"))
    }
    если расш == ".css" {
        вернуть app.сырой_ответ(200, "text/css; charset=utf-8", читать_файл(путь, "utf-8"))
    }
    если расш == ".js" {
        вернуть app.сырой_ответ(200, "application/javascript; charset=utf-8", читать_файл(путь, "utf-8"))
    }
    если расш == ".json" {
        вернуть app.сырой_ответ(200, "application/json; charset=utf-8", читать_файл(путь, "utf-8"))
    }
    если расш == ".svg" {
        вернуть app.сырой_ответ(200, "image/svg+xml", читать_файл(путь, "utf-8"))
    }
    если расш == ".ico" {
        вернуть app.сырой_ответ(200, "image/x-icon", читать_файл(путь, "utf-8"))
    }
    если расш == ".png" {
        вернуть app.сырой_ответ(200, "image/png", читать_файл(путь, "utf-8"))
    }

    вернуть app.текст_ответ(читать_файл(путь, "utf-8"))
})

app.маршрут("/trusted.json", "GET", функция(з) {
    пусть путь = "docs-app/trusted.json"
    если не существует(путь) { путь = "trusted.json" }
    если не существует(путь) {
        вернуть app.текст_ответ("trusted.json не найден", 500)
    }
    вернуть app.сырой_ответ(200, "application/json; charset=utf-8",
        читать_файл(путь, "utf-8"))
})
// ================================================================
// Самопинг, чтобы Render не засыпал
// ================================================================
пусть старт_время = сейчас()
пусть self_url = окружение("RENDER_EXTERNAL_URL")

если self_url != ничего {
    лог("🔁 Самопинг включён:", self_url, "/heal")
    поток(функция() {
        пока истина {
            спать(600)
            попробовать {
                пусть r = http_запрос(self_url + "/heal",
                    {"User-Agent": "SkyForge-SelfPing",
                     "X-Internal": "skyforge-self"})
                лог("[пинг]", дата_сейчас(), "->", r.первые(40))
            } поймать e {
                лог("[пинг] ошибка:", e)
            }
        }
    })
} иначе {
    лог("ℹ️  RENDER_EXTERNAL_URL не найден — самопинг выключен (норма для локальной разработки)")
}

// ================================================================
// Запуск
// ================================================================
лог("📚 SkyForge Documentation v2.3")
лог("   Порт:", порт_сервера())
лог("   Хост:", хост_сервера())
лог("   Открой: http://localhost:" + порт_сервера() + "/")

app.запустить(порт_сервера(), блокировать = истина)
